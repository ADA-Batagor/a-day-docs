 stores file URLs"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"mainPath"},{"type":"text","text":", "},{"type":"codeVoice","code":"thumbnailPath"},{"type":"text","text":"), "},{"type":"codeVoice","code":"createdAt"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"expiredAt"},{"type":"text","text":", optional GPS fields, and"},{"type":"text","text":" "},{"type":"text","text":"computed helpers ("},{"code":"isExpired","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isVideo","type":"codeVoice"},{"text":", ","type":"text"},{"code":"timeRemaining","type":"codeVoice"},{"text":"). Expiry defaults to 24","type":"text"},{"text":" ","type":"text"},{"text":"hours from ","type":"text"},{"code":"createdAt","type":"codeVoice"},{"text":" unless a custom ","type":"text"},{"code":"expiredAt","type":"codeVoice"},{"text":" interval is passed in.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"When deletion actually runs","anchor":"When-deletion-actually-runs"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeletionService"},{"type":"text","text":" doesn’t run on a fixed timer — it’s invoked from three places:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"On launch\/foreground","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"batagorApp"},{"type":"text","text":"’s root view runs "},{"type":"codeVoice","code":"performCleanup(modelContext:)"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":", so expired items are swept the moment the app becomes active —"},{"type":"text","text":" "},{"type":"text","text":"the most common path in practice, since most sessions start with the app opening."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Background","type":"text"}]},{"type