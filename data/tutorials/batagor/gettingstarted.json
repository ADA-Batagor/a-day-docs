{"kind":"project","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials","doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials\/$volume","doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials\/Onboarding"]],"reference":"doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials","modules":[{"reference":"doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials\/Onboarding","projects":[{"reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted","sections":[{"kind":"task","reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Clone-and-open-the-project"},{"kind":"task","reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Configure-signing-and-App-Groups"},{"kind":"task","reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Run-the-app"},{"kind":"task","reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Make-a-small-real-change"}]}]}]},"metadata":{"title":"Set Up and Make Your First Change","categoryPathComponent":"BatagorTutorials","role":"project","category":"batagor"},"identifier":{"url":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted","interfaceLanguage":"swift"},"sections":[{"kind":"hero","title":"Set Up and Make Your First Change","chapter":"Onboarding","estimatedTimeInMinutes":15,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clone the project, get it running on a device, and ship one small, real"},{"type":"text","text":" "},{"type":"text","text":"change to the gallery UI — the fastest way to confirm your environment"},{"type":"text","text":" "},{"type":"text","text":"works end to end before picking up a real issue."}]}]},{"kind":"tasks","tasks":[{"anchor":"Clone-and-open-the-project","title":"Clone and open the project","stepsSection":[{"code":"GettingStarted-01-01.sh","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Clone the repository and open "},{"type":"codeVoice","code":"batagor.xcodeproj"},{"type":"text","text":"."}],"type":"paragraph"}],"caption":[],"media":null},{"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"type":"text","text":"batagor"}]},{"type":"text","text":" scheme and pick a simulator, or a connected"},{"type":"text","text":" "},{"type":"text","text":"iOS 18+ device, as the run destination."}],"type":"paragraph"}],"caption":[],"media":null}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Get the repository onto your machine and open it in Xcode 15+."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"anchor":"Configure-signing-and-App-Groups","title":"Configure signing and App Groups","stepsSection":[{"code":"GettingStarted-02-01.sh","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"From the repo root, run the script with a suffix unique to you"},{"type":"text","text":" "},{"type":"text","text":"(e.g. your own name) — this rewrites the bundle identifier and App"},{"type":"text","text":" "},{"type":"text","text":"Group in both "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" files and "},{"type":"codeVoice","code":"project.pbxproj"},{"type":"text","text":" together."}],"type":"paragraph"}],"caption":[],"media":null},{"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Select the root "},{"type":"strong","inlineContent":[{"type":"text","text":"batagor"}]},{"type":"text","text":" project in the Navigator, choose the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"batagor"}]},{"type":"text","text":" target, open "},{"type":"strong","inlineContent":[{"type":"text","text":"Signing & Capabilities"}]},{"type":"text","text":", and pick your"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"strong","inlineContent":[{"type":"text","text":"Team"}]},{"type":"text","text":" — the bundle identifier is already unique from the"},{"type":"text","text":" "},{"type":"text","text":"previous step, so this just resolves the provisioning profile."}],"type":"paragraph"}],"caption":[],"media":null},{"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"In the same tab, under "},{"type":"strong","inlineContent":[{"type":"text","text":"App Groups"}]},{"type":"text","text":", add\/select the group the"},{"type":"text","text":" "},{"type":"text","text":"script just wrote ("},{"type":"codeVoice","code":"group.com.fuad.<your suffix>"},{"type":"text","text":") — the"},{"type":"text","text":" "},{"type":"text","text":"capability entry and the plist string must match exactly."}],"type":"paragraph"}],"caption":[],"media":null},{"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Repeat the Team and App Groups steps for the "},{"type":"strong","inlineContent":[{"type":"text","text":"widgetExtension"}]},{"type":"text","text":" "},{"type":"text","text":"target — its "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" and bundle identifier were already"},{"type":"text","text":" "},{"type":"text","text":"updated by the script, so only the Xcode signing UI is left. A"},{"type":"text","text":" "},{"type":"text","text":"mismatch here is the most common reason "},{"type":"codeVoice","code":"ModelContainerService"},{"type":"text","text":" "},{"type":"text","text":"fails with “Shared app group container not found” on a physical"},{"type":"text","text":" "},{"type":"text","text":"device."}],"type":"paragraph"}],"caption":[],"media":null},{"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"git config core.hooksPath .githooks"},{"type":"text","text":" once so future"},{"type":"text","text":" "},{"type":"codeVoice","code":"git pull"},{"type":"text","text":"s automatically re-apply your suffix instead of quietly"},{"type":"text","text":" "},{"type":"text","text":"reverting to the team default. See "},{"type":"codeVoice","code":"CONTRIBUTING.md"},{"type":"text","text":" for the full"},{"type":"text","text":" "},{"type":"text","text":"rundown of "},{"type":"codeVoice","code":"local-bundle-id.sh"},{"type":"text","text":"’s other commands."}],"type":"paragraph"}],"caption":[],"media":null}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"The app and widget share media through an App Group, so both targets"},{"type":"text","text":" "},{"type":"text","text":"need a valid signing team "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" matching bundle\/group identifiers"},{"type":"text","text":" "},{"type":"text","text":"before they’ll run on a physical device — the simulator works without"},{"type":"text","text":" "},{"type":"text","text":"this step. "},{"type":"codeVoice","code":"MainAppBundleIdentifier"},{"type":"text","text":" and "},{"type":"codeVoice","code":"GroupAppBundleIdentifier"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" are plain strings the code reads at runtime, so picking a"},{"type":"text","text":" "},{"type":"text","text":"Team in Xcode alone isn’t enough — "},{"type":"codeVoice","code":"scripts\/local-bundle-id.sh"},{"type":"text","text":" "},{"type":"text","text":"automates rewriting them for both targets in one shot."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"anchor":"Run-the-app","title":"Run the app","stepsSection":[{"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Build and run (⌘R). Grant camera, microphone, and location"},{"type":"text","text":" "},{"type":"text","text":"permissions when prompted."}],"type":"paragraph"}],"caption":[],"media":null},{"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Take a photo, confirm it shows up in the gallery, then add the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Capture Snaps"}]},{"type":"text","text":" widget to your Home Screen and confirm its count"},{"type":"text","text":" "},{"type":"text","text":"updates."}],"type":"paragraph"}],"caption":[],"media":null}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Build and run, then confirm the whole capture → save → widget loop"},{"type":"text","text":" "},{"type":"text","text":"works before touching any code."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"anchor":"Make-a-small-real-change","title":"Make a small, real change","stepsSection":[{"code":"GettingStarted-04-01.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Views\/Gallery\/Components\/GalleryHeaderStatus.swift"},{"type":"text","text":" and find"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"statusText"},{"type":"text","text":" call that builds the count label."}],"type":"paragraph"}],"caption":[],"media":null},{"code":"GettingStarted-04-02.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Change the trailing word from “Snaps” to “Moments” and re-run. The"},{"type":"text","text":" "},{"type":"text","text":"gallery header should now read “x \/ 24 Moments”."}],"type":"paragraph"}],"caption":[],"media":null},{"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"You’ve now touched the build, the signing setup, the running app,"},{"type":"text","text":" "},{"type":"text","text":"and the source — you’re ready to pick up a real BAT- issue. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/Architecture"},{"type":"text","text":" for how this one small view fits into the rest"},{"type":"text","text":" "},{"type":"text","text":"of the app."}],"type":"paragraph"}],"caption":[],"media":null}],"contentSection":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/GalleryHeaderStatus"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Views\/Gallery\/Components\/GalleryHeaderStatus.swift"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"renders the “x \/ 24 Snaps” status line under the gallery’s “Today”"},{"type":"text","text":" "},{"type":"text","text":"title — small enough to safely practice a first edit on."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}]}]}],"variants":[{"paths":["\/tutorials\/batagor\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.fuad.batagor/tutorials/batagor/GettingStarted#Run-the-app":{"title":"Run the app","url":"\/tutorials\/batagor\/gettingstarted#Run-the-app","abstract":[{"type":"text","text":"Clone the project, get it running on a device, and ship one small, real"},{"type":"text","text":" "},{"type":"text","text":"change to the gallery UI — the fastest way to confirm your environment"},{"type":"text","text":" "},{"type":"text","text":"works end to end before picking up a real issue."}],"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Run-the-app","type":"section"},"doc://com.fuad.batagor/tutorials/batagor/GettingStarted#Clone-and-open-the-project":{"title":"Clone and open the project","url":"\/tutorials\/batagor\/gettingstarted#Clone-and-open-the-project","abstract":[{"type":"text","text":"Clone the project, get it running on a device, and ship one small, real"},{"type":"text","text":" "},{"type":"text","text":"change to the gallery UI — the fastest way to confirm your environment"},{"type":"text","text":" "},{"type":"text","text":"works end to end before picking up a real issue."}],"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Clone-and-open-the-project","type":"section"},"doc://com.fuad.batagor/tutorials/batagor/GettingStarted#Make-a-small-real-change":{"title":"Make a small, real change","url":"\/tutorials\/batagor\/gettingstarted#Make-a-small-real-change","abstract":[{"type":"text","text":"Clone the project, get it running on a device, and ship one small, real"},{"type":"text","text":" "},{"type":"text","text":"change to the gallery UI — the fastest way to confirm your environment"},{"type":"text","text":" "},{"type":"text","text":"works end to end before picking up a real issue."}],"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Make-a-small-real-change","type":"section"},"doc://com.fuad.batagor/documentation/batagor/Architecture":{"url":"\/documentation\/batagor\/architecture","type":"topic","kind":"article","title":"Architecture","role":"article","abstract":[{"type":"text","text":"The high-level shape of the app: how Views, ViewModels, Services, and Models compose,"},{"type":"text","text":" "},{"type":"text","text":"and where the "},{"type":"codeVoice","code":"widgetExtension"},{"type":"text","text":" target fits in."}],"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/Architecture"},"GettingStarted-04-01.swift":{"identifier":"GettingStarted-04-01.swift","content":["\/\/","\/\/  GalleryHeaderStatus.swift","\/\/  batagor","\/\/","\/\/  Created by Gede Pramananda Kusuma Wisesa on 16\/11\/26.","\/\/","","import SwiftUI","","struct GalleryHeaderStatus: View {","    let currentCount: Int","    let totalLimit: Int = Storage.mediaLimit","","    private let warningSpotsLeft = 3","    private let iconSize: CGFloat = 18","","    private var spotsLeft: Int {","        totalLimit - currentCount","    }","","    var body: some View {","        HStack(spacing: 8) {","            if spotsLeft <= 0 {","                statusIcon(\"exclamationmark.circle\", color: Color.foregroundDanger)","                statusText(\"Limit Reached! (\\(currentCount)\/\\(totalLimit))\", color: Color.foregroundDanger)","            } else if spotsLeft <= warningSpotsLeft {","                statusIcon(\"exclamationmark.triangle\", color: Color.foregroundWarning)","                statusText(","                    \"\\(spotsLeft) \\(spotsLeft == 1 ? \"Spot\" : \"Spots\") left (\\(currentCount)\/\\(totalLimit))\",","                    color: Color.foregroundWarning","                )","            } else {","                CircularProgress(","                    current: currentCount,","                    total: totalLimit,","                    lineWidth: 2.5,","                    size: iconSize","                )","                statusText(\"\\(currentCount) \/ \\(totalLimit) Snaps\", color: Color.darkBase)","            }","        }","        .padding(.bottom, 8)","    }","","    private func statusIcon(_ name: String, color: Color) -> some View {","        Image(systemName: name)","            .resizable()","            .scaledToFit()","            .fontWeight(.semibold)","            .frame(width: iconSize, height: iconSize)","            .foregroundStyle(color)","    }","","    private func statusText(_ text: String, color: Color) -> some View {","        Text(text)","            .font(.spaceGroteskSemiBold(size: 17))","            .foregroundStyle(color)","    }","}","","#Preview {","    VStack(alignment: .leading) {","        GalleryHeaderStatus(currentCount: 10)","        GalleryHeaderStatus(currentCount: 21)","        GalleryHeaderStatus(currentCount: 23)","        GalleryHeaderStatus(currentCount: 24)","    }","}"],"type":"file","fileType":"swift","highlights":[],"fileName":"GalleryHeaderStatus.swift","syntax":"swift"},"doc://com.fuad.batagor/tutorials/BatagorTutorials/Onboarding":{"title":"Onboarding","url":"\/tutorials\/batagortutorials\/onboarding","abstract":[],"role":"article","kind":"article","identifier":"doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials\/Onboarding","type":"topic"},"doc://com.fuad.batagor/documentation/batagor/GalleryHeaderStatus":{"role":"symbol","title":"GalleryHeaderStatus","abstract":[],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"GalleryHeaderStatus"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GalleryHeaderStatus"}],"url":"\/documentation\/batagor\/galleryheaderstatus","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/GalleryHeaderStatus","kind":"symbol"},"doc://com.fuad.batagor/tutorials/batagor/GettingStarted#Configure-signing-and-App-Groups":{"title":"Configure signing and App Groups","url":"\/tutorials\/batagor\/gettingstarted#Configure-signing-and-App-Groups","abstract":[{"type":"text","text":"Clone the project, get it running on a device, and ship one small, real"},{"type":"text","text":" "},{"type":"text","text":"change to the gallery UI — the fastest way to confirm your environment"},{"type":"text","text":" "},{"type":"text","text":"works end to end before picking up a real issue."}],"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Configure-signing-and-App-Groups","type":"section"},"doc://com.fuad.batagor/tutorials/batagor/GettingStarted":{"title":"Set Up and Make Your First Change","url":"\/tutorials\/batagor\/gettingstarted","abstract":[{"type":"text","text":"Clone the project, get it running on a device, and ship one small, real"},{"type":"text","text":" "},{"type":"text","text":"change to the gallery UI — the fastest way to confirm your environment"},{"type":"text","text":" "},{"type":"text","text":"works end to end before picking up a real issue."}],"role":"project","kind":"project","identifier":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted","type":"topic","estimatedTime":"15min"},"GettingStarted-04-02.swift":{"fileType":"swift","highlights":[{"line":39}],"syntax":"swift","identifier":"GettingStarted-04-02.swift","content":["\/\/","\/\/  GalleryHeaderStatus.swift","\/\/  batagor","\/\/","\/\/  Created by Gede Pramananda Kusuma Wisesa on 16\/11\/26.","\/\/","","import SwiftUI","","struct GalleryHeaderStatus: View {","    let currentCount: Int","    let totalLimit: Int = Storage.mediaLimit","","    private let warningSpotsLeft = 3","    private let iconSize: CGFloat = 18","","    private var spotsLeft: Int {","        totalLimit - currentCount","    }","","    var body: some View {","        HStack(spacing: 8) {","            if spotsLeft <= 0 {","                statusIcon(\"exclamationmark.circle\", color: Color.foregroundDanger)","                statusText(\"Limit Reached! (\\(currentCount)\/\\(totalLimit))\", color: Color.foregroundDanger)","            } else if spotsLeft <= warningSpotsLeft {","                statusIcon(\"exclamationmark.triangle\", color: Color.foregroundWarning)","                statusText(","                    \"\\(spotsLeft) \\(spotsLeft == 1 ? \"Spot\" : \"Spots\") left (\\(currentCount)\/\\(totalLimit))\",","                    color: Color.foregroundWarning","                )","            } else {","                CircularProgress(","                    current: currentCount,","                    total: totalLimit,","                    lineWidth: 2.5,","                    size: iconSize","                )","                statusText(\"\\(currentCount) \/ \\(totalLimit) Moments\", color: Color.darkBase)","            }","        }","        .padding(.bottom, 8)","    }","","    private func statusIcon(_ name: String, color: Color) -> some View {","        Image(systemName: name)","            .resizable()","            .scaledToFit()","            .fontWeight(.semibold)","            .frame(width: iconSize, height: iconSize)","            .foregroundStyle(color)","    }","","    private func statusText(_ text: String, color: Color) -> some View {","        Text(text)","            .font(.spaceGroteskSemiBold(size: 17))","            .foregroundStyle(color)","    }","}","","#Preview {","    VStack(alignment: .leading) {","        GalleryHeaderStatus(currentCount: 10)","        GalleryHeaderStatus(currentCount: 21)","        GalleryHeaderStatus(currentCount: 23)","        GalleryHeaderStatus(currentCount: 24)","    }","}"],"type":"file","fileName":"GalleryHeaderStatus.swift"},"GettingStarted-01-01.sh":{"fileType":"","highlights":[],"syntax":"","identifier":"GettingStarted-01-01.sh","content":["git clone git@github.com:ADA-Batagor\/a-day.git","cd a-day","open batagor.xcodeproj"],"type":"file","fileName":"Terminal"},"doc://com.fuad.batagor/tutorials/BatagorTutorials":{"title":"Getting Started with batagor","url":"\/tutorials\/batagortutorials","abstract":[{"type":"text","text":"A short, hands-on walkthrough for new contributors: clone the project, get"},{"type":"text","text":" "},{"type":"text","text":"it running on a device, and make one real change. For everything else —"},{"type":"text","text":" "},{"type":"text","text":"architecture, subsystems, symbol reference — see the main"},{"type":"text","text":" "},{"type":"text","text":"doc:Documentation"},{"type":"text","text":" catalog."}],"role":"overview","kind":"overview","identifier":"doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials","type":"topic"},"GettingStarted-02-01.sh":{"fileType":"","highlights":[],"syntax":"","identifier":"GettingStarted-02-01.sh","content":[".\/scripts\/local-bundle-id.sh set yourname"],"type":"file","fileName":"Terminal"}}}