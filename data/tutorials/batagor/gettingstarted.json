{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/tutorials\/batagor\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"project","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted"},"metadata":{"categoryPathComponent":"BatagorTutorials","title":"Set Up and Make Your First Change","role":"project","category":"batagor"},"hierarchy":{"modules":[{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Clone-and-open-the-project"},{"kind":"task","reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Configure-signing-and-App-Groups"},{"reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Run-the-app","kind":"task"},{"reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted#Make-a-small-real-change","kind":"task"}],"reference":"doc:\/\/com.fuad.batagor\/tutorials\/batagor\/GettingStarted"}],"reference":"doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials\/Onboarding"}],"paths":[["doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials","doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials\/$volume","doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials\/Onboarding"]],"reference":"doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials"},"sections":[{"kind":"hero","title":"Set Up and Make Your First Change","chapter":"Onboarding","estimatedTimeInMinutes":15,"content":[{"type":"paragraph","inlineContent":[{"text":"Clone the project, get it running on a device, and ship one small, real","type":"text"},{"text":" ","type":"text"},{"text":"change to the gallery UI — the fastest way to confirm your environment","type":"text"},{"text":" ","type":"text"},{"text":"works end to end before picking up a real issue.","type":"text"}]}]},{"kind":"tasks","tasks":[{"anchor":"Clone-and-open-the-project","title":"Clone and open the project","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Get the repository onto your machine and open it in Xcode 15+.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"stepsSection":[{"caption":[],"code":"GettingStarted-01-01.sh","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clone the repository and open "},{"type":"codeVoice","code":"batagor.xcodeproj"},{"type":"text","text":"."}]}],"type":"step","runtimePreview":null,"media":null},{"caption":[],"code":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the "},{"inlineContent":[{"text":"batagor","type":"text"}],"type":"strong"},{"type":"text","text":" scheme and pick a simulator, or a connected"},{"type":"text","text":" "},{"type":"text","text":"iOS 18+ device, as the run destination."}]}],"type":"step","runtimePreview":null,"media":null}]},{"anchor":"Configure-signing-and-App-Groups","title":"Configure signing and App Groups","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"The app and widget share media through an App Group, so both targets"},{"type":"text","text":" "},{"type":"text","text":"need a valid signing team "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" matching bundle\/group identifiers"},{"text":" ","type":"text"},{"text":"before they’ll run on a physical device — the simulator works without","type":"text"},{"text":" ","type":"text"},{"text":"this step. ","type":"text"},{"code":"MainAppBundleIdentifier","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"GroupAppBundleIdentifier","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" are plain strings the code reads at runtime, so picking a","type":"text"},{"text":" ","type":"text"},{"text":"Team in Xcode alone isn’t enough — ","type":"text"},{"code":"scripts\/local-bundle-id.sh","type":"codeVoice"},{"text":" ","type":"text"},{"text":"automates rewriting them for both targets in one shot.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"From the repo root, run the script with a suffix unique to you"},{"type":"text","text":" "},{"type":"text","text":"(e.g. your own name) — this rewrites the bundle identifier and App"},{"type":"text","text":" "},{"type":"text","text":"Group in both "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" files and "},{"type":"codeVoice","code":"project.pbxproj"},{"type":"text","text":" together."}]}],"caption":[],"code":"GettingStarted-02-01.sh","media":null,"runtimePreview":null},{"type":"step","content":[{"inlineContent":[{"type":"text","text":"Select the root "},{"inlineContent":[{"type":"text","text":"batagor"}],"type":"strong"},{"text":" project in the Navigator, choose the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"batagor","type":"text"}],"type":"strong"},{"text":" target, open ","type":"text"},{"inlineContent":[{"type":"text","text":"Signing & Capabilities"}],"type":"strong"},{"text":", and pick your","type":"text"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"inlineContent":[{"type":"text","text":"Team"}],"type":"strong"},{"text":" — the bundle identifier is already unique from the","type":"text"},{"text":" ","type":"text"},{"text":"previous step, so this just resolves the provisioning profile.","type":"text"}],"type":"paragraph"}],"caption":[],"code":null,"media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the same tab, under ","type":"text"},{"inlineContent":[{"type":"text","text":"App Groups"}],"type":"strong"},{"text":", add\/select the group the","type":"text"},{"text":" ","type":"text"},{"text":"script just wrote (","type":"text"},{"code":"group.com.fuad.<your suffix>","type":"codeVoice"},{"text":") — the","type":"text"},{"text":" ","type":"text"},{"text":"capability entry and the plist string must match exactly.","type":"text"}]}],"code":null,"runtimePreview":null,"caption":[],"type":"step","media":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat the Team and App Groups steps for the "},{"inlineContent":[{"type":"text","text":"widgetExtension"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"target — its "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" and bundle identifier were already"},{"type":"text","text":" "},{"type":"text","text":"updated by the script, so only the Xcode signing UI is left. A"},{"type":"text","text":" "},{"type":"text","text":"mismatch here is the most common reason "},{"code":"ModelContainerService","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"fails with “Shared app group container not found” on a physical"},{"type":"text","text":" "},{"type":"text","text":"device."}]}],"code":null,"runtimePreview":null,"caption":[],"type":"step","media":null},{"caption":[],"media":null,"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Run ","type":"text"},{"type":"codeVoice","code":"git config core.hooksPath .githooks"},{"text":" once so future","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"git pull"},{"text":"s automatically re-apply your suffix instead of quietly","type":"text"},{"text":" ","type":"text"},{"text":"reverting to the team default. See ","type":"text"},{"type":"codeVoice","code":"CONTRIBUTING.md"},{"text":" for the full","type":"text"},{"text":" ","type":"text"},{"text":"rundown of ","type":"text"},{"type":"codeVoice","code":"local-bundle-id.sh"},{"text":"’s other commands.","type":"text"}],"type":"paragraph"}]}]},{"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Build and run, then confirm the whole capture → save → widget loop","type":"text"},{"text":" ","type":"text"},{"text":"works before touching any code.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"anchor":"Run-the-app","title":"Run the app","stepsSection":[{"type":"step","media":null,"code":null,"caption":[],"content":[{"inlineContent":[{"text":"Build and run (⌘R). Grant camera, microphone, and location","type":"text"},{"type":"text","text":" "},{"type":"text","text":"permissions when prompted."}],"type":"paragraph"}],"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"Take a photo, confirm it shows up in the gallery, then add the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Capture Snaps"}],"type":"strong"},{"text":" widget to your Home Screen and confirm its count","type":"text"},{"text":" ","type":"text"},{"text":"updates.","type":"text"}]}],"type":"step","media":null,"caption":[],"code":null,"runtimePreview":null}]},{"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/GalleryCount","isActive":true,"type":"reference"},{"text":" (","type":"text"},{"code":"Views\/Shared\/GalleryCount.swift","type":"codeVoice"},{"text":") renders the","type":"text"},{"text":" ","type":"text"},{"text":"“x \/ 24 Snaps” label under the gallery grid — small enough to safely","type":"text"},{"text":" ","type":"text"},{"text":"practice a first edit on.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"stepsSection":[{"code":"GettingStarted-04-01.swift","type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Views\/Shared\/GalleryCount.swift"},{"type":"text","text":" and find the "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" view"},{"type":"text","text":" "},{"type":"text","text":"that builds the count label."}]}],"caption":[],"media":null},{"code":"GettingStarted-04-02.swift","type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Change the trailing word from “Snaps” to “Moments” and re-run. The"},{"type":"text","text":" "},{"type":"text","text":"gallery header should now read “x \/ 24 Moments”."}]}],"caption":[],"media":null},{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You’ve now touched the build, the signing setup, the running app,"},{"type":"text","text":" "},{"type":"text","text":"and the source — you’re ready to pick up a real BAT- issue. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/Architecture"},{"type":"text","text":" for how this one small view fits into the rest"},{"type":"text","text":" "},{"type":"text","text":"of the app."}]}],"type":"step","runtimePreview":null,"media":null,"code":null}],"anchor":"Make-a-small-real-change","title":"Make a small, real change"}]}],"references":{"doc://com.fuad.batagor/tutorials/BatagorTutorials":{"role":"overview","title":"Getting Started with batagor","url":"\/tutorials\/batagortutorials","type":"topic","kind":"overview","identifier":"doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials","abstract":[{"type":"text","text":"A short, hands-on walkthrough for new contributors: clone the project, get"},{"type":"text","text":" "},{"type":"text","text":"it running on a device, and make one real change. For everything else —"},{"type":"text","text":" "},{"type":"text","text":"architecture, subsystems, symbol reference — see the main"},{"type":"text","text":" "},{"type":"text","text":"doc:Documentation"},{"type":"text","text":" catalog."}]},"doc://com.fuad.batagor/tutorials/batagor/GettingStarted#Configure-signing-and-App-Groups":{"abstract":[{"type":"text","text":"Clone the project, get it running on a device, and ship one small, real"},{"type":"text","text":" "},{"type":"text","text":"change to the gallery UI — the fastest way to confirm your enviro