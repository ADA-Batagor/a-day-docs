{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"code":"CameraManager","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Core\/Services\/Camera\/","type":"codeVoice"},{"text":") is a thin wrapper around ","type":"text"},{"code":"AVFoundation","type":"codeVoice"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"owns the ","type":"text"},{"code":"AVCaptureSession","type":"codeVoice"},{"text":" and exposes three ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":"s instead of delegate","type":"text"},{"text":" ","type":"text"},{"text":"callbacks, so ","type":"text"},{"code":"CameraViewModel","type":"codeVoice"},{"text":" can consume them with ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"previewStream: AsyncStream<CIImage>"},{"type":"text","text":" — live viewfinder frames, produced in"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVCaptureVideoDataOutputSampleBufferDelegate.captureOutput(_:didOutput:from:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"photoStream: AsyncStream<Data>"},{"type":"text","text":" — encoded photo data per "},{"type":"codeVoice","code":"takePhoto()"},{"type":"text","text":" call,"},{"type":"text","text":" "},{"type":"text","text":"extracted immediately in"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVCapturePhotoCaptureDelegate.photoOutput(_:didFinishProcessingPhoto:error:)"},{"type":"text","text":" so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVCapturePhoto"},{"type":"text","text":" instance (and its underlying hardware "},{"type":"codeVoice","code":"IOSurface"},{"type":"text","text":" buffer) is released"},{"type":"text","text":" "},{"type":"text","text":"as soon as the delegate callback returns."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"movieFileStream: AsyncStream<URL>"},{"type":"text","text":" — the finished movie file URL after"},{"type":"text","text":" "},{"type":"codeVoice","code":"stopRecordingVideo()"},{"type":"text","text":", produced in"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVCaptureFileOutputRecordingDelegate.fileOutput(_:didFinishRecordingTo:from:error:)"},{"type":"text","text":"."}]}]}]},{"inlineContent":[{"code":"CameraViewModel.init()","type":"codeVoice"},{"text":" starts three ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":"s (","type":"text"},{"code":"handleCameraPreview","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"handleCameraPhoto","type":"codeVoice"},{"text":", ","type":"text"},{"code":"handleCameraMovie","type":"codeVoice"},{"text":") that each drain one of these streams.","type":"text"},{"text":" ","type":"text"},{"code":"handleCameraPreview","type":"codeVoice"},{"text":" publishes frames to ","type":"text"},{"code":"previewImage","type":"codeVoice"},{"text":" (which also gates the shutter","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"CameraToolbar","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CameraViewModel","type":"codeVoice"},{"text":" so captures cannot fire while the preview is","type":"text"},{"text":" ","type":"text"},{"text":"still blank), while ","type":"text"},{"code":"handleCameraPhoto","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"handleCameraMovie","type":"codeVoice"},{"text":" trigger persistence","type":"text"},{"text":" ","type":"text"},{"text":"directly from the view model rather than through view ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":" modifiers.","type":"text"}],"type":"paragraph"},{"anchor":"Capture-flow","type":"heading","text":"Capture flow","level":2},{"type":"codeListing","code":["CameraManager.start()","  └─ checkCameraAuthorization() → configureCaptureSession() → captureSession.startRunning()","","User taps shutter (photo)","  CameraViewModel.capturePhoto(storedCount:)","    → guards previewImage != nil and storedCount + pendingSaves < Storage.mediaLimit","    → increments pendingSaves + starts UIApplication background task","    → camera.takePhoto()","        → snapshots latestPreviewImage in fallbackImagesByID[photoSettings.uniqueID]","        → AVCapturePhotoOutput.capturePhoto(...)","        → photoOutput(_:didFinishProcessingPhoto:error:)","            ├─ photo.fileDataRepresentation() succeeds → photoStream yields HEIC Data","            └─ nil (e.g. session interrupted on backgrounding) → encodes fallback","               viewfinder snapshot to JPEG Data → photoStream yields Data","    → handleCameraPhoto() appends (Data, currentLocation) to photoQueue","    → handleSavePhoto(context:) drains photoQueue:","        → Task.detached: addLocationToImageData + savePhoto(data:) + saveThumbnail(data:)","        → @MainActor: inserts Storage row + saves ModelContext + reloads widget timelines","        → decrements pendingSaves","        → enqueueGeocode(for:context:) resolves place name sequentially in background","        → enqueueFocusDetection(for:context:) finds the thumbnail focus sequentially in background","","User holds shutter (video)","  CameraViewModel.startRecordingVideo(storedCount:)","    → guards previewImage != nil, !isCameraInterrupted, and capacity under mediaLimit","    → increments pendingSaves + starts UIApplication background task","    → camera.startRecordingVideo() \/ stopRecordingVideo()","        → movieFileOutput writes directly to the App Group container","        → fileOutput(_:didFinishRecordingTo:from:error:) → movieFileStream yields URL","    → handleSaveMovie(context:) embeds location + generates thumbnail + saves Storage row,","      then queues reverse-geocoding via enqueueGeocode(for:context:) and focus detection","      via enqueueFocusDetection(for:context:)"],"syntax":null},{"anchor":"Fast-capture-and-backgrounding-resilience","type":"heading","text":"Fast capture and backgrounding resilience","level":2},{"inlineContent":[{"text":"Rapid shutter taps followed immediately by navigating away or swiping to the iOS Home","type":"text"},{"text":" ","type":"text"},{"text":"Screen exercise several edge cases that the pipeline handles explicitly:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Adaptive burst prioritization"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"configureCaptureSession(completionHandler:)"},{"type":"text","text":" sets"},{"type":"text","text":" "},{"type":"codeVoice","code":"photoOutput.maxPhotoQualityPrioritization = .balanced"},{"type":"text","text":" and enables both"},{"type":"text","text":" "},{"type":"codeVoice","code":"isResponsiveCaptureEnabled"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isFastCapturePrioritizationEnabled"},{"type":"text","text":", while"},{"type":"text","text":" "},{"type":"codeVoice","code":"takePhoto()"},{"type":"text","text":" requests "},{"type":"codeVoice","code":"photoSettings.photoQualityPrioritization = .balanced"},{"type":"text","text":". Normal"},{"type":"text","text":" "},{"type":"text","text":"single shots get full multi-frame fusion quality, while rapid back-to-back taps are"},{"type":"text","text":" "},{"type":"text","text":"automatically accelerated by "},{"type":"codeVoice","code":"AVCapturePhotoOutput"},{"type":"text","text":" without stalling the pipeline."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Immediate "},{"type":"codeVoice","code":"IOSurface"},{"type":"text","text":" release"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"AVCapturePhotoOutput"},{"type":"text","text":" has a small, fixed-size pool"},{"type":"text","text":" "},{"type":"text","text":"of hardware pixel buffers. Extracting "},{"type":"codeVoice","code":"photo.fileDataRepresentation()"},{"type":"text","text":" inside"},{"type":"text","text":" "},{"type":"codeVoice","code":"photoOutput(_:didFinishProcessingPhoto:error:)"},{"type":"text","text":" and yielding "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" (instead of"},{"type":"text","text":" "},{"type":"text","text":"retaining "},{"type":"codeVoice","code":"AVCapturePhoto"},{"type":"text","text":" across async queues) returns each buffer to the pool in"},{"type":"text","text":" "},{"type":"text","text":"under a millisecond so burst captures never starve the sensor."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Viewfinder snapshot fallback"}]},{"type":"text","text":": iOS immediately interrupts "},{"type":"codeVoice","code":"AVCaptureSession"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":".videoDeviceNotAvailableInBackground"},{"type":"text","text":" when the app enters the background, which"},{"type":"text","text":" "},{"type":"text","text":"aborts any queued "},{"type":"codeVoice","code":"AVCapturePhotoOutput"},{"type":"text","text":" requests that have not finished sensor"},{"type":"text","text":" "},{"type":"text","text":"capture yet ("},{"type":"codeVoice","code":"photo.fileDataRepresentation()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"). To avoid dropping those"},{"type":"text","text":" "},{"type":"text","text":"trailing shots, "},{"type":"codeVoice","code":"takePhoto()"},{"type":"text","text":" records the latest viewfinder "},{"type":"codeVoice","code":"CIImage"},{"type":"text","text":" and rotation"},{"type":"text","text":" "},{"type":"text","text":"angle in "},{"type":"codeVoice","code":"fallbackImagesByID"},{"type":"text","text":" keyed by "},{"type":"codeVoice","code":"photoSettings.uniqueID"},{"type":"text","text":"; if hardware capture"},{"type":"text","text":" "},{"type":"text","text":"is interrupted, "},{"type":"codeVoice","code":"encodeFallbackSnapshot(_:)"},{"type":"text","text":" encodes that captured frame to JPEG "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" "},{"type":"text","text":"and yields it to "},{"type":"codeVoice","code":"photoStream"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deferred session stop"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"CameraManager.stop()"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"inFlightPhotoCount"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"sessionQueue"},{"type":"text","text":". If the user leaves "},{"type":"codeVoice","code":"CameraView"},{"type":"text","text":" while captures are still in flight,"},{"type":"text","text":" "},{"type":"codeVoice","code":"shouldStopWhenPhotosFinish"},{"type":"text","text":" defers "},{"type":"codeVoice","code":"captureSession.stopRunning()"},{"type":"text","text":" until the last"},{"type":"text","text":" "},{"type":"text","text":"in-flight photo callback completes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Off-main-actor I\/O and immediate SwiftData insert"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"handleSavePhoto(context:)"},{"type":"text","text":" "},{"type":"text","text":"runs EXIF GPS merging ("},{"type":"codeVoice","code":"LocationManager.addLocationToImageData(_:location:)"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"full-resolution file writing ("},{"type":"codeVoice","code":"StorageManager.savePhoto(data:)"},{"type":"text","text":"), and ImageIO"},{"type":"text","text":" "},{"type":"text","text":"thumbnail downsampling ("},{"type":"codeVoice","code":"StorageManager.saveThumbnail(data:)"},{"type":"text","text":") inside a detached task"},{"type":"text","text":" "},{"type":"text","text":"off "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":". The "},{"type":"codeVoice","code":"Storage"},{"type":"text","text":" record is inserted and saved into "},{"type":"codeVoice","code":"ModelContext"},{"type":"text","text":" "},{"type":"text","text":"immediately—before network reverse-geocoding ("},{"type":"codeVoice","code":"enqueueGeocode(for:context:)"},{"type":"text","text":")—while a"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" background task keeps the process alive until "},{"type":"codeVoice","code":"pendingSaves"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"activeGeocodeCount"},{"type":"text","text":" and "},{"type":"codeVoice","code":"activeFocusCount"},{"type":"text","text":" all reach zero."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Focus detection after the save"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"enqueueFocusDetection(for:context:)"},{"type":"text","text":" runs"},{"type":"text","text":" "},{"type":"codeVoice","code":"ThumbnailFocusService"},{"type":"text","text":" (Vision) after the row is saved, one snap at a time and off"},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":", on its own chain, so it never delays the insert or the burst queue. Photos"},{"type":"text","text":" "},{"type":"text","text":"are read from "},{"type":"codeVoice","code":"mainPath"},{"type":"text","text":" at up to 2048px through"},{"type":"text","text":" "},{"type":"codeVoice","code":"StorageManager.loadDownsampledImage(fileURL:maxPixelSize:)"},{"type":"text","text":" rather than from the"},{"type":"text","text":" "},{"type":"text","text":"low-quality thumbnail JPEG; videos use their saved thumbnail frame. Any failure leaves"},{"type":"text","text":" "},{"type":"text","text":"the focus nil and the snap saved. The row is fetched again by "},{"type":"codeVoice","code":"id"},{"type":"text","text":" before writing, in"},{"type":"text","text":" "},{"type":"text","text":"case it was deleted while Vision ran. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background interruption filtering"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"observeInterruptions()"},{"type":"text","text":" ignores"},{"type":"text","text":" "},{"type":"codeVoice","code":".videoDeviceNotAvailableInBackground"},{"type":"text","text":" when setting "},{"type":"codeVoice","code":"interruptionMessage"},{"type":"text","text":" so normal"},{"type":"text","text":" "},{"type":"text","text":"app backgrounding never surfaces a "},{"type":"codeVoice","code":"\"Camera unavailable\""},{"type":"text","text":" alert, and "},{"type":"codeVoice","code":"CameraViewModel"},{"type":"text","text":" "},{"type":"text","text":"binds "},{"type":"codeVoice","code":"showInterruptionAlert"},{"type":"text","text":" to "},{"type":"codeVoice","code":"message != nil"},{"type":"text","text":" so any alert clears when the"},{"type":"text","text":" "},{"type":"text","text":"interruption ends."}]}]}]},{"anchor":"Earlier-pipeline-and-why-it-changed","type":"heading","text":"Earlier pipeline and why it changed","level":3},{"inlineContent":[{"text":"Before BAT-108, BAT-109, and BAT-111, the capture flow worked as follows:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["User taps shutter (earlier flow)","  CameraToolbar (enabled before previewImage arrived; disabled at capacity without alert)","    → camera.takePhoto()","    → photoOutput(_:didFinishProcessingPhoto:) → photoStream yields AVCapturePhoto","    → CameraViewModel.unpackPhoto(_:) decodes fileDataRepresentation() + cgImageRepresentation()","      on @MainActor and publishes photoTaken","    → CameraView .onChange(of: photoTaken?.imageData) spawns Task { handleSavePhoto(context:) }","    → handleSavePhoto(context:) on @MainActor:","        writes photo + UIImage thumbnail → awaits storeLocation(storage:) (CLGeocoder)","        → inserts Storage row into SwiftData (counter updates only after save finishes)"],"syntax":null},{"inlineContent":[{"text":"That earlier design had several failure modes under fast capture or quick navigation:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Counter lag and silent capacity taps (BAT-108)"}]},{"type":"text","text":": The gallery counter only read"},{"type":"text","text":" "},{"type":"text","text":"persisted "},{"type":"codeVoice","code":"@Query"},{"type":"text","text":" rows, so rapid taps did not increment the counter until disk I\/O"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"CLGeocoder"},{"type":"text","text":" finished, and disabling the shutter at 24\/24 prevented tapping the"},{"type":"text","text":" "},{"type":"text","text":"shutter from surfacing the storage-limit alert."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Captures before preview readiness (BAT-111)"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"CameraToolbar"},{"type":"text","text":" did not check"},{"type":"text","text":" "},{"type":"codeVoice","code":"previewImage == nil"},{"type":"text","text":", allowing shutter taps while the viewfinder was still blank"},{"type":"text","text":" "},{"type":"text","text":"before "},{"type":"codeVoice","code":"AVCaptureSession"},{"type":"text","text":" produced its first frame."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Buffer starvation and dropped shots on backgrounding\/navigation (BAT-109)"}]},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Passing live "},{"type":"codeVoice","code":"AVCapturePhoto"},{"type":"text","text":" objects through "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" while "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"text","text":"performed synchronous bitmap decoding ("},{"type":"codeVoice","code":"cgImageRepresentation()"},{"type":"text","text":"), EXIF re-encoding,"},{"type":"text","text":" "},{"type":"text","text":"and full-resolution "},{"type":"codeVoice","code":"UIGraphicsImageRenderer"},{"type":"text","text":" thumbnail drawing exhausted"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVCapturePhotoOutput"},{"type":"text","text":"’s small hardware "},{"type":"codeVoice","code":"IOSurface"},{"type":"text","text":" pool after ~4–6 shots."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Triggering "},{"type":"codeVoice","code":"handleSavePhoto"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleSaveMovie"},{"type":"text","text":" from "},{"type":"codeVoice","code":"CameraView"},{"type":"text","text":"’s "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":" "},{"type":"text","text":"modifiers meant saves stopped firing as soon as "},{"type":"codeVoice","code":"CameraView"},{"type":"text","text":" unmounted or entered"},{"type":"text","text":" "},{"type":"text","text":"the background."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Awaiting "},{"type":"codeVoice","code":"storeLocation(storage:)"},{"type":"text","text":" ("},{"type":"codeVoice","code":"CLGeocoder"},{"type":"text","text":") "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"context.insert(storage)"},{"type":"text","text":" "},{"type":"text","text":"without a "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" background task caused in-flight saves to suspend before"},{"type":"text","text":" "},{"type":"text","text":"reaching SwiftData when swiping to the Home Screen."}]}]}]}]}]},{"anchor":"Rotation-and-device-switching","type":"heading","text":"Rotation and device switching","level":2},{"inlineContent":[{"code":"CameraManager","type":"codeVoice"},{"text":" tracks device orientation itself via ","type":"text"},{"code":"AVCaptureDevice.RotationCoordinator","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"setupRotationCoordinator()","type":"codeVoice"},{"text":"), independent of ","type":"text"},{"code":"OrientationManager","type":"codeVoice"},{"text":" (which drives UI","type":"text"},{"text":" ","type":"text"},{"text":"rotation via ","type":"text"},{"code":"CoreMotion","type":"codeVoice"},{"text":"). ","type":"text"},{"code":"switchCaptureDevices()","type":"codeVoice"},{"text":" cycles between the first","type":"text"},{"text":" ","type":"text"},{"text":"available back and front camera; ","type":"text"},{"code":"updateSessionForCaptureDevice(_:)","type":"codeVoice"},{"text":" reconfigures the","type":"text"},{"text":" ","type":"text"},{"text":"session’s input without tearing down outputs.","type":"text"}],"type":"paragraph"},{"anchor":"Location-tagging","type":"heading","text":"Location tagging","level":2},{"inlineContent":[{"text":"Both photos and videos get their coordinate stored on the ","type":"text"},{"code":"Storage","type":"codeVoice"},{"text":" record","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"latitude","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"longitude","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"altitude","type":"codeVoice"},{"text":") and embedded in the file. For photos,","type":"text"},{"text":" ","type":"text"},{"code":"handleSavePhoto(context:)","type":"codeVoice"},{"text":" writes the original ","type":"text"},{"code":"AVCapturePhoto","type":"codeVoice"},{"text":" data (so EXIF, lens and","type":"text"},{"text":" ","type":"text"},{"text":"timestamp metadata survive) after ","type":"text"},{"code":"LocationManager.addLocationToImageData(_:location:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"merges in the GPS dictionary. For videos, ","type":"text"},{"code":"handleSaveMovie(context:)","type":"codeVoice"},{"text":" awaits","type":"text"},{"text":" ","type":"text"},{"code":"LocationManager.addLocationToVideo(at:location:)","type":"codeVoice"},{"text":", which embeds QuickTime location","type":"text"},{"text":" ","type":"text"},{"text":"metadata into the exported movie file. When saving to the Photos app,","type":"text"},{"text":" ","type":"text"},{"code":"PhotoLibraryService","type":"codeVoice"},{"text":" also sets the asset’s creation date and location.","type":"text"},{"text":" ","type":"text"},{"text":"Both photo and","type":"text"},{"text":" ","type":"text"},{"text":"video saves also reverse-geocode the coordinate into a human-readable place name —","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Article","role":"article","title":"Camera Pipeline","modules":[{"name":"batagor"}]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion","doc:\/\/com.fuad.batagor\/documentation\/batagor\/WidgetIntegration","doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding"],"title":"Subsystems","anchor":"Subsystems"}],"hierarchy":{"paths":[["doc:\/\/com.fuad.batagor\/documentation\/batagor"]]},"abstract":[{"type":"text","text":"How a frame goes from the camera sensor to a saved, expiring file."}],"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/batagor\/camerapipeline"]}],"identifier":{"url":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/CameraPipeline","interfaceLanguage":"swift"},"references":{"doc://com.fuad.batagor/documentation/batagor":{"role":"collection","title":"batagor","abstract":[{"type":"text","text":"Temporary storage for photos and videos — captures expire and clean themselves up"},{"type":"text","text":" "},{"type":"text","text":"automatically so they never clutter your camera roll."}],"type":"topic","url":"\/documentation\/batagor","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor","kind":"symbol"},"doc://com.fuad.batagor/documentation/batagor/LocationAndGeocoding":{"role":"article","url":"\/documentation\/batagor\/locationandgeocoding","kind":"article","title":"Location and Geocoding","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding","type":"topic","abstract":[{"type":"text","text":"How captured media gets tagged with where it was taken."}]},"doc://com.fuad.batagor/documentation/batagor/WidgetIntegration":{"url":"\/documentation\/batagor\/widgetintegration","type":"topic","kind":"article","title":"Widget Integration","role":"article","abstract":[{"type":"text","text":"How the Home Screen widget stays in sync with the app without any explicit"},{"type":"text","text":" "},{"type":"text","text":"messaging between the two targets."}],"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/WidgetIntegration"},"doc://com.fuad.batagor/documentation/batagor/StorageAndDeletion":{"role":"article","title":"Storage and Deletion","abstract":[{"text":"Where files and records live, and how expired media gets removed.","type":"text"}],"type":"topic","url":"\/documentation\/batagor\/storageanddeletion","kind":"article","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion"}}}