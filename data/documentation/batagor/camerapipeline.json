{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"type":"text","text":"How a frame goes from the camera sensor to a saved, expiring file."}],"hierarchy":{"paths":[["doc:\/\/com.fuad.batagor\/documentation\/batagor"]]},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"CameraManager"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Core\/Services\/Camera\/"},{"type":"text","text":") is a thin wrapper around "},{"type":"codeVoice","code":"AVFoundation"},{"type":"text","text":". It"},{"type":"text","text":" "},{"type":"text","text":"owns the "},{"type":"codeVoice","code":"AVCaptureSession"},{"type":"text","text":" and exposes three "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":"s instead of delegate"},{"type":"text","text":" "},{"type":"text","text":"callbacks, so "},{"type":"codeVoice","code":"CameraViewModel"},{"type":"text","text":" can consume them with "},{"type":"codeVoice","code":"for await"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"previewStream: AsyncStream<CIImage>"},{"type":"text","text":" — live viewfinder frames, produced in"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVCaptureVideoDataOutputSampleBufferDelegate.captureOutput(_:didOutput:from:)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"code":"photoStream: AsyncStream<AVCapturePhoto>","type":"codeVoice"},{"text":" — one value per ","type":"text"},{"code":"takePhoto()","type":"codeVoice"},{"text":" call,","type":"text"},{"text":" ","type":"text"},{"text":"produced in ","type":"text"},{"code":"AVCapturePhotoCaptureDelegate.photoOutput(_:didFinishProcessingPhoto:error:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"movieFileStream: AsyncStream<URL>"},{"type":"text","text":" — the finished movie file URL after"},{"type":"text","text":" "},{"type":"codeVoice","code":"stopRecordingVideo()"},{"type":"text","text":", produced in"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVCaptureFileOutputRecordingDelegate.fileOutput(_:didFinishRecordingTo:from:error:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CameraViewModel.init()"},{"type":"text","text":" starts three "},{"type":"codeVoice","code":"Task"},{"type":"text","text":"s ("},{"type":"codeVoice","code":"handleCameraPreview"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"handleCameraPhoto"},{"type":"text","text":", "},{"type":"codeVoice","code":"handleCameraMovie"},{"type":"text","text":") that each drain one of these streams into a"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" property ("},{"code":"previewImage","type":"codeVoice"},{"text":", ","type":"text"},{"code":"photoTaken","type":"codeVoice"},{"text":", ","type":"text"},{"code":"movieFileURL","type":"codeVoice"},{"text":") that","type":"text"},{"text":" ","type":"text"},{"code":"CameraView","type":"codeVoice"},{"text":" renders.","type":"text"}]},{"text":"Capture flow","type":"heading","level":2,"anchor":"Capture-flow"},{"code":["CameraManager.start()","  └─ checkAuthorization() → configureCaptureSession() → captureSession.startRunning()","","User taps shutter (photo)","  CameraViewModel → camera.takePhoto()","    → AVCapturePhotoOutput.capturePhoto(...)","    → photoOutput(_:didFinishProcessingPhoto:) → photoStream yields AVCapturePhoto","    → CameraViewModel.unpackPhoto(_:) decodes it into PhotoData","    → photoTaken is published → CameraView shows a review screen","    → handleSavePhoto(context:) writes it to disk + SwiftData (see StorageAndDeletion)","","User holds shutter (video)","  CameraViewModel → camera.startRecordingVideo() \/ stopRecordingVideo()","    → movieFileOutput writes directly to the App Group container","    → fileOutput(_:didFinishRecordingTo:) → movieFileStream yields the URL","    → handleSaveMovie(context:) generates a thumbnail + writes to SwiftData"],"type":"codeListing","syntax":null},{"text":"Rotation and device switching","type":"heading","level":2,"anchor":"Rotation-and-device-switching"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CameraManager"},{"type":"text","text":" tracks device orientation itself via "},{"type":"codeVoice","code":"AVCaptureDevice.RotationCoordinator"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"setupRotationCoordinator()"},{"type":"text","text":"), independent of "},{"type":"codeVoice","code":"OrientationManager"},{"type":"text","text":" (which drives UI"},{"type":"text","text":" "},{"type":"text","text":"rotation via "},{"type":"codeVoice","code":"CoreMotion"},{"type":"text","text":"). "},{"type":"codeVoice","code":"switchCaptureDevices()"},{"type":"text","text":" cycles between the first"},{"type":"text","text":" "},{"type":"text","text":"available back and front camera; "},{"type":"codeVoice","code":"updateSessionForCaptureDevice(_:)"},{"type":"text","text":" reconfigures the"},{"type":"text","text":" "},{"type":"text","text":"session’s input without tearing down outputs."}]},{"level":2,"text":"Location tagging","anchor":"Location-tagging","type":"heading"},{"inlineContent":[{"type":"text","text":"Photos and videos are geotagged differently. For photos, "},{"type":"codeVoice","code":"CameraViewModel"},{"type":"text","text":" stores the"},{"type":"text","text":" "},{"type":"text","text":"captured coordinate directly on the "},{"type":"codeVoice","code":"Storage"},{"type":"text","text":" record ("},{"type":"codeVoice","code":"latitude"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"longitude"},{"type":"text","text":"\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"altitude"},{"type":"text","text":") rather than embedding it in the image file — "},{"type":"codeVoice","code":"LocationManager"},{"type":"text","text":" does have"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"addLocationToImage(_:location:)"},{"type":"text","text":" helper for EXIF embedding, but nothing currently"},{"type":"text","text":" "},{"type":"text","text":"calls it. For videos, "},{"type":"codeVoice","code":"handleSaveMovie(context:)"},{"type":"text","text":" calls"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocationManager.addLocationToVideo(at:location:)"},{"type":"text","text":", which embeds the coordinate as"},{"type":"text","text":" "},{"type":"text","text":"QuickTime location metadata directly into the exported movie file. Both photo and"},{"type":"text","text":" "},{"type":"text","text":"video saves also reverse-geocode the coordinate into a human-readable place name —"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/batagor\/camerapipeline"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/CameraPipeline"},"metadata":{"title":"Camera Pipeline","modules":[{"name":"batagor"}],"role":"article","roleHeading":"Article"},"sections":[],"seeAlsoSections":[{"anchor":"Subsystems","generated":true,"title":"Subsystems","identifiers":["doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion","doc:\/\/com.fuad.batagor\/documentation\/batagor\/WidgetIntegration","doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding"]}],"references":{"doc://com.fuad.batagor/documentation/batagor":{"url":"\/documentation\/batagor","abstract":[{"type":"text","text":"Temporary storage for photos and videos — captures expire and clean themselves up"},{"type":"text","text":" "},{"type":"text","text":"automatically so they never clutter your camera roll."}],"title":"batagor","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor"},"doc://com.fuad.batagor/documentation/batagor/LocationAndGeocoding":{"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding","abstract":[{"type":"text","text":"How captured media gets tagged with where it was taken."}],"kind":"article","title":"Location and Geocoding","role":"article","type":"topic","url":"\/documentation\/batagor\/locationandgeocoding"},"doc://com.fuad.batagor/documentation/batagor/StorageAndDeletion":{"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion","abstract":[{"type":"text","text":"Where files and records live, and how expired media gets removed."}],"kind":"article","title":"Storage and Deletion","role":"article","type":"topic","url":"\/documentation\/batagor\/storageanddeletion"},"doc://com.fuad.batagor/documentation/batagor/WidgetIntegration":{"title":"Widget Integration","url":"\/documentation\/batagor\/widgetintegration","type":"topic","abstract":[{"type":"text","text":"How the Home Screen widget stays in sync with the app without any explicit"},{"type":"text","text":" "},{"type":"text","text":"messaging between the two targets."}],"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/WidgetIntegration","role":"article","kind":"article"}}}