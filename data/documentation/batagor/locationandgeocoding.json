code":"MKPlacemark","type":"codeVoice"},{"text":", with a ","type":"text"},{"code":"displayName","type":"codeVoice"},{"text":" that falls back through","type":"text"},{"text":" ","type":"text"},{"text":"name → thoroughfare → subLocality → locality → areas of interest → ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". It returns","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" rather than placeholder text so a failed lookup stays distinguishable from a","type":"text"},{"text":" ","type":"text"},{"text":"place genuinely named “Unknown Location”.","type":"text"}]},{"anchor":"How-a-save-picks-up-location-+-place-name","level":2,"type":"heading","text":"How a save picks up location + place name"},{"type":"paragraph","inlineContent":[{"code":"CameraViewModel.storeLocation(storage:)","type":"codeVoice"},{"type":"text","text":" runs during both "},{"code":"handleSavePhoto","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"handleSaveMovie","type":"codeVoice"},{"type":"text","text":", after the "},{"code":"Storage","type":"codeVoice"},{"type":"text","text":" row’s coordinate fields are already set from"},{"type":"text","text":" "},{"code":"locationManager.currentLocation","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["storeLocation(storage:)","  guard let location = locationManager.currentLocation","      else → storage.locationUnavailableReason =","                 PermissionStatusService.status(for: .location) == .on","                     ? .noLocationFix : .permissionOff","  → geocodeManager.reverseGeocode(coordinate: location.coordinate)","  → if let name = geocodeManager.placemarkInfo?.displayName","        storage.locationName = name","        storage.locationCity = geocodeManager.placemarkInfo?.locality","        storage.locationUnavailableReason = nil","    else","        storage.locationUnavailableReason = .geocodeFailed","  → geocodeManager.reset()"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"codeVoice","code":"GeocodeManager"},{"type":"text","text":" is reset after every save so stale "},{"type":"codeVoice","code":"placemarkInfo"},{"type":"text","text":" from a previous"},{"type":"text","text":" "},{"type":"text","text":"capture never leaks into the next one — each "},{"type":"codeVoice","code":"CameraViewModel"},{"type":"text","text":" owns one"},{"type":"text","text":" "},{"type":"codeVoice","code":"GeocodeManager"},{"type":"text","text":" instance for its whole lifetime, not one per capture."}],"type":"paragraph"},{"anchor":"Why-the-reason-is-stored-instead-of-re-derived","text":"Why the reason is stored instead of re-derived","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"Storage.locationUnavailableReason"},{"type":"text","text":" ("},{"type":"codeVoice","code":"LocationUnavailableReason"},{"type":"text","text":", declared alongside"},{"type":"text","text":" "},{"type":"text","text":"the model in "},{"type":"codeVoice","code":"Models\/Storage.swift"},{"type":"text","text":") records "},{"type":"emphasis","inlineContent":[{"type":"text","text":"why"}]},{"type":"text","text":" a snap has no place name, and"},{"type":"text","text":" "},{"code":"Storage.locationUnavailableText","type":"codeVoice"},{"type":"text","text":" maps it to the label the UI shows — “Location Off”"},{"type":"text","text":" "},{"type":"text","text":"for "},{"code":"permissionOff","type":"codeVoice"},{"type":"text","text":", “Location Unavailable” for both "},{"code":"noLocationFix","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"geocodeFailed","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is written at capture time rather than resolved when the label renders, because"},{"type":"text","text":" "},{"code":"widgetExtension","type":"codeVoice"},{"type":"text","text":" is a separate process reading the same Ap