d","type":"codeVoice"},{"text":") removes expired records: it fetches","type":"text"},{"text":" ","type":"text"},{"text":"every ","type":"text"},{"code":"Storage","type":"codeVoice"},{"text":" row, filters where ","type":"text"},{"code":"expiredAt < Date()","type":"codeVoice"},{"text":", deletes the backing files","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"StorageManager.deleteFile(fileURL:)","type":"codeVoice"},{"text":", deletes the SwiftData rows, and calls","type":"text"},{"text":" ","type":"text"},{"code":"WidgetCenter.shared.reloadAllTimelines()","type":"codeVoice"},{"text":" so the widget picks up the change.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"ThumbnailFocusService"}],"type":"strong"},{"text":" (","type":"text"},{"code":"static let shared","type":"codeVoice"},{"text":") finds the point a cropped thumbnail","type":"text"},{"text":" ","type":"text"},{"text":"should pan to, using on-device Vision. See “Thumbnail focus” below.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Storage"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Models\/Storage.swift"},{"type":"text","text":") is the SwiftData "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":": it stores file URLs"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"mainPath"},{"type":"text","text":", "},{"type":"codeVoice","code":"thumbnailPath"},{"type":"text","text":"), "},{"type":"codeVoice","code":"createdAt"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"expiredAt"},{"type":"text","text":", optional GPS fields, an"},{"type":"text","text":" "},{"type":"text","text":"optional thumbnail focus ("},{"type":"codeVoice","code":"focusX"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"focusY"},{"type":"text","text":"), and computed helpers ("},{"type":"codeVoice","code":"isExpired"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"isVideo"},{"type":"text","text":", "},{"type":"codeVoice","code":"timeRemaining"},{"type":"text","text":", "},{"type":"codeVoice","code":"focusPoint"},{"type":"text","text":"). Expiry defaults to 24 hours from "},{"type":"codeVoice","code":"createdAt"},{"type":"text","text":" "},{"type":"text","text":"unless a custom "},{"type":"codeVoice","code":"expiredAt"},{"type":"text","text":" interval is passed in."}]},{"level":2,"type":"heading","text":"Thumbnail focus","anchor":"Thumbnail-focus"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every screen crops the same thumbnail, and on a roughly 393pt-wide phone the 170pt"},{"type":"text","text":" "},{"type":"text","text":"gallery card shows only about the middle 24% of a portrait photo’s height. So the snap"},{"type":"text","text":" "},{"type":"text","text":"stores where to look rather than a second, cropped file; the thumbnail JPEG itself is"},{"type":"text","text":" "},{"type":"text","text":"never changed."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"ThumbnailFocusService"}],"type":"strong"},{"text":" finds the point: the centre of the largest confident text","type":"text"},{"text":" ","type":"text"},{"text":"box containing a digit, or, if there’s none or it covers most of the frame, the centre","type":"text"},{"text":" ","type":"text"},{"text":"of the main object from a saliency request. Otherwise there is no focus. Its thresholds","type":"text"},{"text":" ","type":"text"},{"text":"are named constants, still provisional until tuned on the sample photo set.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"Storage.focusX"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"focusY"}],"type":"strong"},{"text":" hold the point, normalized 0 to 1 with a top-left origin.","type":"text"},{"text":" ","type":"text"},{"text":"Both are optional and additive, so rows that predate them stay nil.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"FocusFillImage"}],"type":"strong"},{"text":" pans an aspect-fill image to the point at each call site, clamped","type":"text"},{"text":" ","type":"text"},{"text":"so no gap ever shows and never zooming. With a nil focus it’s a plain aspect-fill, so","type":"text"},{"text":" ","type":"text"},{"text":"that screen renders exactly as it would without a focus.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A number at the very edge of a photo can only pan as far as that edge, so on the gallery"},{"type":"text","text":" "},{"type":"text","text":"card it can still sit under "},{"type":"codeVoice","code":"TimeRemainingBar"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/CameraPipeline","isActive":true},{"type":"text","text":" for when detection runs."}]},{"level":2,"type":"heading","text":"The media limit","anchor":"The-media-limit"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Storage.mediaLimit"},{"type":"text","text":" (24) is the single source of truth, enforced in two layers:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"CameraViewModel.capturePhoto(storedCount:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"startRecordingVideo(storedCount:)"}],"type":"strong"},{"text":" ","type":"text"},{"text":"gate the shutter: each allows capture only while the stored count plus in-flight","type":"text"},{"text":" ","type":"text"},{"text":"media items (","type":"text"},{"code":"pendingSaves","type":"codeVoice"},{"text":") is under the limit, so fast burst taps and video","type":"text"},{"text":" ","type":"text"},{"text":"recordings cannot outrun the ","type":"text"},{"code":"@Query","type":"codeVoice"},{"text":" count.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"StorageManager.hasCapacity(in:)"}],"type":"strong"},{"text":" is the final guard, run with a live","type":"text"},{"text":" ","type":"text"},{"code":"fetchCount","type":"codeVoice"},{"text":" before writing files and again right before ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":". If the limit was","type":"text"},{"text":" ","type":"text"},{"text":"reached in the meantime, the saved files are discarded.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"When deletion actually runs","anchor":"When-deletion-actually-runs"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeletionService"},{"type":"text","text":" doesn’t run on a fixed timer — it’s invoked from three places:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"On launch\/foreground"}],"type":"strong"},{"text":": ","type":"text"},{"code":"batagorApp","type":"codeVoice"},{"text":"’s root view runs ","type":"text"},{"code":"performCleanup(modelContext:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":", so expired items are swept the moment the app becomes active —","type":"text"},{"text":" ","type":"text"},{"text":"the most common path in practice, since most sessions start with the app opening.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Background"}],"type":"strong"},{"text":": ","type":"text"},{"code":".backgroundTask(.appRefresh(DeletionService.backgroundTaskIdentifier))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"batagorApp","type":"codeVoice"},{"text":" is what actually registers the handler with the system; inside it,","type":"text"},{"text":" ","type":"text"},{"code":"performCleanup(modelContext:)","type":"codeVoice"},{"text":" runs and then re-arms itself via","type":"text"},{"text":" ","type":"text"},{"code":"scheduleBackgroundCleanup()","type":"codeVoice"},{"text":", which submits a ","type":"text"},{"code":"BGAppRefreshTaskRequest","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"BackgroundTasks","type":"codeVoice"},{"text":" framework) for the system to run opportunistically later. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/AppLifecycle","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual"}],"type":"strong"},{"text":": every user-initiated delete goes through a ","type":"text"},{"code":"manualDelete","type":"codeVoice"},{"text":" overload —","type":"text"},{"text":" ","type":"text"},{"code":"manualDelete(modelContext:storage:)","type":"codeVoice"},{"text":" from the gallery card’s long-press menu and","type":"text"},{"text":" ","type":"text"},{"text":"the detail view, and ","type":"text"},{"code":"manualDelete(modelContext:ids:)","type":"codeVoice"},{"text":" from swipe-to-delete and","type":"text"},{"text":" ","type":"text"},{"text":"select-mode bulk delete. The ID variant fetches the rows at call time, so a row","type":"text"},{"text":" ","type":"text"},{"text":"expiry cleanup already removed is skipped. A bulk delete saves once and reloads","type":"text"},{"text":" ","type":"text"},{"text":"widget timelines once.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All three paths funnel through the same file-then-record deletion order and the same"},{"type":"text","text":" "},{"type":"codeVoice","code":"WidgetCenter"},{"type":"text","text":" reload, so there’s a single source of truth for “how a "},{"type":"codeVoice","code":"Storage"},{"type":"text","text":" row"},{"type":"text","text":" "},{"type":"text","text":"disappears.” No view deletes a "},{"type":"codeVoice","code":"Storage"},{"type":"text","text":" row with "},{"type":"codeVoice","code":"modelContext.delete"},{"type":"text","text":" directly:"},{"type":"text","text":" "},{"type":"text","text":"that leaves the row’s files on disk with nothing pointing at them."}]},{"level":2,"type":"heading","text":"Orphaned files","anchor":"Orphaned-files"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A file in "},{"type":"codeVoice","code":"Photos\/"},{"type":"text","text":", "},{"type":"codeVoice","code":"Movies\/"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Thumbnails\/"},{"type":"text","text":" that no "},{"type":"codeVoice","code":"Storage"},{"type":"text","text":" row references is"},{"type":"text","text":" "},{"type":"text","text":"unreachable by the paths above, since they all work from rows. Such files come from"},{"type":"text","text":" "},{"type":"text","text":"swipe deletes before BAT-84 and bulk deletes before BAT-86 (both deleted only the"},{"type":"text","text":" "},{"type":"text","text":"row), a capture whose save failed partway, a movie that finished recording after its"},{"type":"text","text":" "},{"type":"codeVoice","code":"CameraView"},{"type":"text","text":" was gone, or a video location export interrupted mid-write."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"removeOrphanedFiles(modelContext:)"},{"type":"text","text":" sweeps them on launch, right after the expiry"},{"type":"text","text":" "},{"type":"text","text":"cleanup in "},{"type":"codeVoice","code":"batagorApp"},{"type":"text","text":"’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Files are matched to rows by ","type":"text"},{