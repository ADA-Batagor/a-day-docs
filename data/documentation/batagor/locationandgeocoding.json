); the latest","type":"text"},{"text":" ","type":"text"},{"text":"fix is published as ","type":"text"},{"type":"codeVoice","code":"currentLocation"},{"text":". It also embeds coordinates into finished","type":"text"},{"text":" ","type":"text"},{"text":"media: ","type":"text"},{"type":"codeVoice","code":"addLocationToVideo(at:location:)"},{"text":" awaits an export that adds QuickTime location","type":"text"},{"text":" ","type":"text"},{"text":"metadata to a recorded movie (keeping its existing metadata), and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"addLocationToImageData(_:location:)"},{"text":" merges an EXIF GPS dictionary into a photo’s","type":"text"},{"text":" ","type":"text"},{"text":"encoded data without discarding its other metadata. Both are used by","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CameraViewModel"},{"text":" before the file is stored. ","type":"text"},{"type":"codeVoice","code":"PhotoLibraryService"},{"text":" also sets the","type":"text"},{"text":" ","type":"text"},{"text":"asset’s ","type":"text"},{"type":"codeVoice","code":"creationDate"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"location"},{"text":" from the ","type":"text"},{"type":"codeVoice","code":"Storage"},{"text":" record when saving to Photos.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"GeocodeManager"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":") turns a coordinate into a human-readable"},{"type":"text","text":" "},{"type":"codeVoice","code":"PlacemarkInfo"},{"type":"text","text":" via "},{"type":"codeVoice","code":"CLGeocoder.reverseGeocodeLocation(_:)"},{"type":"text","text":", publishing the result"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"placemarkInfo"},{"type":"text","text":". It also has an unused "},{"type":"codeVoice","code":"searchForBuilding(coordinate:)"},{"type":"text","text":" path"},{"type":"text","text":" "},{"type":"text","text":"that ranks nearby "},{"type":"codeVoice","code":"MKLocalSearch"},{"type":"text","text":" points of interest — currently commented out in"},{"type":"text","text":" "},{"type":"codeVoice","code":"reverseGeocode(coordinate:)"},{"type":"text","text":" (“Inconsistency accurate building location”), so only"},{"type":"text","text":" "},{"type":"text","text":"the plain "},{"type":"codeVoice","code":"CLGeocoder"},{"type":"text","text":" path runs today."}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"PlacemarkInfo"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Models\/PlacemarkInfo.swift"},{"type":"text","text":") is a plain struct built from either a"},{"type":"text","text":" "},{"type":"codeVoice","code":"CLPlacemark"},{"type":"text","text":" or an "},{"type":"codeVoice","code":"MKPlacemark"},{"type":"text","text":", with a "},{"type":"codeVoice","code":"displayName"},{"type":"text","text":" that falls back through"},{"type":"text","text":" "},{"type":"text","text":"name → thoroughfare → subLocality → locality → areas of interest → "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". It returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" rather than placeholder text so a failed lookup stays distinguishable from a"},{"type":"text","text":" "},{"type":"text","text":"place genuinely named “Unknown Location”."}],"type":"paragraph"},{"anchor":"How-a-save-picks-up-location-+-place-name","type":"heading","text":"How a save picks up location + place name","level":2},{"inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"handleSavePhoto"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleSaveMovie"},{"type":"text","text":" insert and save the "},{"type":"codeVoice","code":"Storage"},{"type":"text","text":" row (with its"},{"type":"text","text":" "},{"type":"text","text":"coordinate fields set from "},{"type":"codeVoice","code":"locationManager.currentLocation"},{"type":"text","text":") immediately, then queue"},{"type":"text","text":" "},{"type":"codeVoice","code":"CameraViewModel.storeLocation(storage:)"},{"type":"text","text":" sequentially in the background so slow or"},{"type":"text","text":" "},{"type":"text","text":"interrupted network geocoding never delays or drops a capture:"}],"type":"paragraph"},{"type":"codeListing","code":["storeLocation(storage:)","  guard let latitude = storage.latitude, let longitude = storage.longitude","      else → storage.locationUnavailableReason =","                 PermissionStatusService.status(for: .location) == .on","                     ? .noLocationFix : .permissionOff","  → geocodeManager.reverseGeocode(coordinate: CLLocationCoordinate2D(latitude: latitude, longitude: longitude))","  → if let name = geocodeManager.placemarkInfo?.displayName","        storage.locationName = name","        storage.locationCity = geocodeManager.placemarkInfo?.locality","        storage.locationUnavailableReason = nil","    else","        storage.locationUnavailableReason = .geocodeFailed","  → geocodeManager.reset()"],"syntax":null},{"inlineContent":[{"type":"codeVoice","code":"GeocodeManager"},{"type":"text","text":" is reset after every save so stale "},{"type":"codeVoice","code":"placemarkInfo"},{"type":"text","text":" from a previous"},{"type":"text","text":" "},{"type":"text","text":"capture never leaks into the next one — each "},{"type":"codeVoice","code":"CameraViewModel"},{"type":"text","text":" owns one"},{"type":"text","text":" "},{"type":"codeVoice","code":"GeocodeManager"},{"type":"text","text":" instance for its whole lifetime, not one per capture."}],"type":"paragraph"},{"anchor":"Why-the-reason-is-stored-instead-of-re-derived","type":"heading","text":"Why the reason is stored instead of re-derived","level":2},{"inlineContent":[{"type":"codeVoice","code":"Storage.locationUnavailableReason"},{"type":"text","text":" ("},{"type":"codeVoice","code":"LocationUnavailableReason"},{"type":"text","text":", declared alongside"},{"type":"text","text":" "},{"type":"text","text":"the model in "},{"type":"codeVoice","code":"Models\/Storage.swift"},{"type":"text","text":") records "},{"type":"emphasis","inlineContent":[{"type":"text","text":"why"}]},{"type":"text","text":" a snap has no place name, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Storage.locationUnavailableText"},{"type":"text","text":" maps it to the label the UI shows — “Location Off”"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"codeVoice","code":"permissionOff"},{"type":"text","text":", “Location Unavailable” for both "},{"type":"codeVoice","code":"noLocationFix"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"geocodeFailed"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is written at capture time rather than resolved when the label renders, because"},{"type":"text","text":" "},{"type":"codeVoice","code":"widgetExtension"},{"type":"text","text":" is a separate process reading the same App Group store: it cannot"},{"type":"text","text":" "},{"type":"text","text":"usefully ask "},{"type":"codeVoice","code":"PermissionStatusService"},{"type":"text","text":" about the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"app’s"}]},{"type":"text","text":" location permission, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"PermissionStatusService"},{"type":"text","text":" is not a member of the widget target. Persisting the reason"},{"type":"text","text":" "},{"type":"text","text":"on the row means both "},{"type":"codeVoice","code":"TimeRemainingBar"},{"type":"text","text":" and "},{"type":"codeVoice","code":"widget.swift"},{"type":"text","text":" render it identically"},{"type":"text","text":" "},{"type":"text","text":"without either one needing permission APIs. The enum lives in "},{"type":"codeVoice","code":"Storage.swift"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"same reason — that file is already shared with the widget target, so no target"},{"type":"text","text":" "},{"type":"text","text":"membership exception has to be added for it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The field is optional, so rows captured before it existed carry "},{"type":"codeVoice","code":"nil"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"locationUnavailableText"},{"type":"text","text":" treats that as "},{"type":"codeVoice","code":"noLocationFix"},{"type":"text","text":", which shows the neutral"},{"type":"text","text":" "},{"type":"text","text":"wording rather than wrongly telling the user their permission is off."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.fuad.batagor/documentation/batagor":{"role":"collection","title":"batagor","abstract":[{"type":"text","text":"Temporary storage for photos and videos — captures expire and clean themselves up"},{"type":"text","text":" "},{"type":"text","text":"automatically so they never clutter your camera roll."}],"type":"topic","url":"\/documentation\/batagor","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor","kind":"symbol"},"doc://com.fuad.batagor/documentation/batagor/CameraPipeline":{"title":"Camera Pipeline","url":"\/documentation\/batagor\/camerapipeline","abstract":[{"type":"text","text":"How a frame goes from the camera sensor to a saved, expiring file."}],"role":"article","kind":"article","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/CameraPipeline","type":"topic"},"doc://com.fuad.batagor/documentation/batagor/StorageAndDeletion":{"role":"article","title":"Storage and Deletion","abstract":[{"text":"Where files and records live, and how expired media gets removed.","type":"text"}],"type":"topic","url":"\/documentation\/batagor\