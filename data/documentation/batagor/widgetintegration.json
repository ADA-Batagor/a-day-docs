e":"text"},{"code":"widgetAccessory.swift","type":"codeVoice"},{"text":" in its ","type":"text"},{"code":".camera","type":"codeVoice"},{"text":" mode (a ","type":"text"},{"code":"Button(intent:)","type":"codeVoice"},{"text":" in the Lock Screen","type":"text"},{"text":" ","type":"text"},{"text":"widget area), and ","type":"text"},{"code":"BatagorAppShortcuts","type":"codeVoice"},{"text":" (an ","type":"text"},{"code":"AppShortcut","type":"codeVoice"},{"text":", so it’s invokable via","type":"text"},{"text":" ","type":"text"},{"text":"Siri\/Shortcuts). ","type":"text"},{"code":"ShortcutManager","type":"codeVoice"},{"text":" handles the equivalent quick-action path when","type":"text"},{"text":" ","type":"text"},{"text":"launched from a Home Screen long-press.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Every accessory mode also carries a ","type":"text"},{"code":".widgetURL","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"batagor:\/\/camera","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".camera","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"batagor:\/\/gallery","type":"codeVoice"},{"text":" for the read-only modes — so a tap routed as a widget-URL open","type":"text"},{"text":" ","type":"text"},{"text":"instead of an intent still lands somewhere sensible via","type":"text"},{"text":" ","type":"text"},{"code":"batagorApp.handleDeepLink(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Registered widgets","type":"heading","level":2,"anchor":"Registered-widgets"},{"inlineContent":[{"code":"widgetBundle","type":"codeVoice"},{"text":" registers three widgets:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"widget","type":"codeVoice"},{"type":"text","text":" — the Home Screen gallery\/timer glance, in three sizes"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"SmallWidgetView","type":"codeVoice"},{"type":"text","text":", "},{"code":"MediumWidgetView","type":"codeVoice"},{"type":"text","text":", "},{"code":"LargeWidgetView","type":"codeVoice"},{"type":"text","text":", falling back to"},{"type":"text","text":" "},{"code":"EmptyWidgetView","type":"codeVoice"},{"type":"text","text":" when there’s no media). Thumbnails are decoded via"},{"type":"text","text":" "},{"code":"StorageManager.loadDownsampledImage(fileURL:maxPixelSize:)","type":"codeVoice"},{"type":"text","text":" straight to the size"},{"type":"text","text":" "},{"type":"text","text":"each view draws (1200px for the single-image view, 400px per medium tile), so the"},{"type":"text","text":" "},{"type":"text","text":"extension never holds a full-size bitmap under its tight memory limit. Each image"},{"type":"text","text":" "},{"type":"text","text":"draws through "},{"code":"FocusFillImage","type":"codeVoice"},{"type":"text","text":" ("},{"code":"Views\/Shared\/FocusFillImage.swift","type":"codeVoice"},{"type":"text","text":", a member of both"},{"type":"text","text":" "},{"type":"text","text":"targets), which pans to the snap’s stored focus at whatever size the family offers;"},{"type":"text","text":" "},{"type":"text","text":"see "},{"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion","type":"reference","isActive":true},{"type":"text","text":". The extension never runs detection itself: the app"},{"type":"text","text":" "},{"type":"text","text":"reloads timelines when it stores a focus, so a snap can first appear centre-cropped and"},{"type":"text","text":" "},{"type":"text","text":"pan on the next reload."},{"type":"text","text":" "},{"code":"fetchRecentMedia","type":"codeVoice"},{"type":"text","text":" only checks that each thumbnail file exists; it doesn’t decode it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"widgetAccessory","type":"codeVoice"},{"type":"text","text":" — the Lock Screen widget, in "},{"code":".accessoryCircular","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":".accessoryRectangular","type":"codeVoice"},{"type":"text","text":" and "},{"code":".accessoryInline","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"widgetControl","type":"codeVoice"},{"type":"text","text":" — the Control Center \/ Lock Screen–corner camera shortcut."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"The accessory widget’s three modes","type":"heading","level":2,"anchor":"The-accessory-widgets-three-modes"},{"inlineContent":[{"code":"widgetAccessory","type":"codeVoice"},{"text":" is a single gallery entry backed by ","type":"text"},{"code":"AppIntentConfiguration","type":"codeVoice"},{"text":", not","type":"text"},{"text":" ","type":"text"},{"text":"three separate widgets. ","type":"text"},{"code":"AccessoryConfigurationIntent","type":"codeVoice"},{"text":" exposes one ","type":"text"},{"code":"AccessoryMode","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter (","type":"text"},{"code":".camera","type":"codeVoice"},{"text":", ","type":"text"},{"code":".timeLeft","type":"codeVoice"},{"text":", ","type":"text"},{"code":".count","type":"codeVoice"},{"text":"), so the user long-presses ▸ ","type":"text"},{"inlineContent":[{"type":"text","text":"Edit Widget"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"to switch what it shows. Adding a fourth readout means a new ","type":"text"},{"code":"AccessoryMode","type":"codeVoice"},{"text":" case and","type":"text"},{"text":" ","type":"text"},{"text":"a view, not a new ","type":"text"},{"code":"Widget","type":"codeVoice"},{"text":" registration.","type":"text"}],"type":"paragraph"},{"text":"Why it doesn’t reuse `Provider`","type":"heading","level":3,"anchor":"Why-it-doesnt-reuse-Provider"},{"inlineContent":[{"code":"AccessoryProvider","type":"codeVoice"},{"text":" fetches only what the accessory views need — the newest and oldest","type":"text"},{"text":" ","type":"text"},{"text":"surviving ","type":"text"},{"code":"expiredAt","type":"codeVoice"},{"text":", plus a count — and never touches ","type":"text"},{"code":"thumbnailPath","type":"codeVoice"},{"text":", so it skips","type":"text"},{"text":" ","type":"text"},{"text":"the thumbnail decodes ","type":"text"},{"code":"Provider","type":"codeVoice"},{"text":"’s views do on every refresh.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"More importantly it does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" copy ","type":"text"},{"code":"Provider","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":".after(1 minute)","type":"codeVoice"},{"text":" policy. Home","type":"text"},{"text":" ","type":"text"},{"text":"Screen and Lock Screen widgets from the same extension share one refresh budget","type":"text"},{"text":" ","type":"text"},{"text":"(roughly 40–70 reloads\/day for the whole app), so a second minute-by-minute timeline","type":"text"},{"text":" ","type":"text"},{"text":"would starve the Home Screen widget. Instead the countdown and gauge views update","type":"text"},{"text":" ","type":"text"},{"text":"themselves on screen:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".timeLeft"},{"type":"text","text":" renders "},{"type":"codeVoice","code":"Text(timerInterval:countsDown:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ProgressView(timerInterval:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which tick without any reload."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".count"},{"type":"text","text":" renders a "},{"type":"codeVoice","code":"Gauge"},{"type":"text","text":", which only changes when media does — and the app already"},{"type":"text","text":" "},{"type":"text","text":"pushes those changes via "},{"typ