":"same "},{"code":"ModelContainerService.shared","type":"codeVoice"}],"type":"strong"},{"text":" — the widget’s ","type":"text"},{"code":"Provider","type":"codeVoice"},{"text":" opens","type":"text"},{"text":" ","type":"text"},{"code":"ModelContainerService.shared.mainContext","type":"codeVoice"},{"text":" directly and runs the same","type":"text"},{"text":" ","type":"text"},{"code":"FetchDescriptor<Storage>","type":"codeVoice"},{"text":" queries the app would, rather than receiving pushed","type":"text"},{"text":" ","type":"text"},{"text":"data.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"There is no custom sync code: because both targets point at the same SQLite file in","type":"text"},{"text":" ","type":"text"},{"text":"the same App Group container, a write from the app is immediately visible to any","type":"text"},{"text":" ","type":"text"},{"code":"ModelContext","type":"codeVoice"},{"text":" the widget opens afterward.","type":"text"}],"type":"paragraph"},{"text":"Refresh flow","type":"heading","level":2,"anchor":"Refresh-flow"},{"type":"codeListing","code":["App writes\/deletes a Storage row (CameraViewModel.handleSavePhoto, DeletionService, ...)","  → WidgetCenter.shared.reloadAllTimelines()","      → WidgetKit re-invokes Provider.getTimeline(in:completion:)","          → fetchRecentMedia(limit:) \/ fetchCountMedia() re-query the shared store","          → GalleryEntry rebuilt, Timeline scheduled"],"syntax":null},{"inlineContent":[{"code":"getTimeline","type":"codeVoice"},{"text":" also self-schedules its ","type":"text"},{"inlineContent":[{"type":"text","text":"next"}],"type":"emphasis"},{"text":" refresh independent of app activity:","type":"text"},{"text":" ","type":"text"},{"code":".after(nextUpdate)","type":"codeVoice"},{"text":", 1 minute out if there’s media, 5 minutes out if empty — so the","type":"text"},{"text":" ","type":"text"},{"text":"countdown shown in the widget keeps advancing even if the app ne