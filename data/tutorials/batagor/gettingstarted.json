{"kind":"project","metadata":{"categoryPathComponent":"BatagorTutorials","role":"project","category":"batagor","title":"Set Up and Make Your First Change"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[{"estimatedTimeInMinutes":15,"content":[{"inlineContent":[{"text":"Clone the project, get it running on a device, and ship one small, real","type":"text"},{"text":" ","type":"text"},{"text":"change to the gallery UI — the fastest way to confirm your environment","type":"text"},{"text":" ","type":"text"},{"text":"works end to end before picking up a real issue.","type":"text"}],"type":"paragraph"}],"title":"Set Up and Make Your First Change","kind":"hero","chapter":"Onboarding"},{"tasks":[{"anchor":"Clone-and-open-the-project","title":"Clone and open the project","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Get the repository onto your machine and open it in Xcode 15+.","type":"text"}],"type":"paragraph"}]}],"stepsSection":[{"code":"GettingStarted-01-01.sh","runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"text":"Clone the repository and open ","type":"text"},{"code":"batagor.xcodeproj","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"text":"Select the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"batagor"}]},{"text":" scheme and pick a simulator, or a connected","type":"text"},{"text":" ","type":"text"},{"text":"iOS 18+ device, as the run destination.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Configure-signing-and-App-Groups","title":"Configure signing and App Groups","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"text":"The app and widget share media through an App Group, so both targets","type":"text"},{"text":" ","type":"text"},{"text":"need a valid signing team ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"text":" matching bundle\/group identifiers","type":"text"},{"text":" ","type":"text"},{"text":"before they’ll run on a physical device — the simulator works without","type":"text"},{"text":" ","type":"text"},{"text":"this step. ","type":"text"},{"code":"MainAppBundleIdentifier","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"GroupAppBundleIdentifier","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" are plain strings the code reads at runtime, so picking a","type":"text"},{"text":" ","type":"text"},{"text":"Team in Xcode alone isn’t enough — ","type":"text"},{"code":"scripts\/local-bundle-id.sh","type":"codeVoice"},{"text":" ","type":"text"},{"text":"automates rewriting them for both targets in one shot.","type":"text"}],"type":"paragraph"}]}],"stepsSection":[{"code":"GettingStarted-02-01.sh","runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"text":"From the repo root, run the script with a suffix unique to you","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. your own name) — this rewrites the bundle identifier and App","type":"text"},{"text":" ","type":"text"},{"text":"Group in both ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" files and ","type":"text"},{"code":"project.pbxproj","type":"codeVoice"},{"text":" together.","type":"text"}],"type":"paragraph"}]},{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"text":"Select the root ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"batagor"}]},{"text":" project in the Navigator, choose the","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"batagor"}]},{"text":" target, open ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Signing & Capabilities"}]},{"text":", and pick your","type":"text"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Team"}]},{"text":" — the bundle identifier is already unique from the","type":"text"},{"text":" ","type":"text"},{"text":"previous step, so this just resolves the provisioning profile.","type":"text"}],"type":"paragraph"}]},{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"text":"In the same tab, under ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"App Groups"}]},{"text":", add\/select the group the","type":"text"},{"text":" ","type":"text"},{"text":"script just wrote (","type":"text"},{"code":"group.com.fuad.<your suffix>","type":"codeVoice"},{"text":") — the","type":"text"},{"text":" ","type":"text"},{"text":"capability entry and the plist string must match exactly.","type":"text"}],"type":"paragraph"}]},{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"text":"Repeat the Team and App Groups steps for the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"widgetExtension"}]},{"text":" ","type":"text"},{"text":"target — its ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" and bundle identifier were already","type":"text"},{"text":" ","type":"text"},{"text":"updated by the script, so only the Xcode signing UI is left. A","type":"text"},{"text":" ","type":"text"},{"text":"mismatch here is the most common reason ","type":"text"},{"code":"ModelContainerService","type":"codeVoice"},{"text":" ","type":"text"},{"text":"fails with “Shared app group container not found” on a physical","type":"text"},{"text":" ","type":"text"},{"text":"device.","type":"text"}],"type":"paragraph"}]},{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"git config core.hooksPath .githooks"},{"type":"text","text":" once so future"},{"type":"text","text":" "},{"type":"codeVoice","code":"git pull"},{"type":"text","text":"s automatically re-apply your suffix instead of quietly"},{"type":"text","text":" "},{"type":"text","text":"reverting to the team default. See "},{"type":"codeVoice","code":"CONTRIBUTING.md"},{"type":"text","text":" for the full"},{"type":"text","text":" "},{"type":"text","text":"rundown of "},{"type":"codeVoice","code":"local-bundle-id.sh"},{"type":"text","text":"’s other commands."}],"type":"paragraph"}]}]},{"anchor":"Run-the-app","title":"Run the app","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Build and run, then confirm the whole capture → save → widget loop"},{"type":"text","text":" "},{"type":"text","text":"works before touching any code."}],"type":"paragraph"}]}],"stepsSection":[{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"type":"text","text":"Build and run (⌘R). Grant camera, microphone, and location"},{"type":"text","text":" "},{"type":"text","text":"permissions when prompted."}],"type":"paragraph"}]},{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"type":"text","text":"Take a photo, confirm it shows up in the gallery, then add the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Capture Snaps"}]},{"type":"text","text":" widget to your Home Screen and confirm its count"},{"type":"text","text":" "},{"type":"text","text":"updates."}],"type":"paragraph"}]}]},{"anchor":"Make-a-small-real-change","title":"Make a small, real change","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/GalleryCount","isActive":true},{"type":"text","text":" ("},{"type":"codeVoice","code":"Views\/Shared\/GalleryCount.swift"},{"type":"text","text":") renders the"},{"type":"text","text":" "},{"type":"text","text":"“x \/ 24 Snaps” label under the gallery grid — small enough to safely"},{"type":"text","text":" "},{"type":"text","text":"practice a first edit on."}],"type":"paragraph"}]}],"stepsSection":[{"code":"GettingStarted-04-01.swift","runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Views\/Shared\/GalleryCount.swift"},{"type":"text","text":" and find the "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" view"},{"type":"text","text":" "},{"type":"text","text":"that builds the count label."}],"type":"paragraph"}]},{"code":"GettingStarted-04-02.swift","runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"type":"text","text":"Change the trailing word from “Snaps” to “Moments” and re-run. The"},{"type":"text","text":" "},{"type":"text","text":"gallery header should now read “x \/ 24 Moments”."}],"type":"paragraph"}]},{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"type":"text","text":"You’ve now touched the build, the signing setup, the running app,"},{"type":"text","text":" "},{"type":"text","text":"and the source — you’re ready to pick up a real BAT- issue. See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/Architecture","isActive":true},{"type":"text","text":" for how this one small view fits into the rest"},{"type":"text","text":" "},{"type":"text","text":"of the app."}],"type":"paragraph"}]}]}],"kind":"tasks"}],"hierarchy":{"paths":[["doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials","doc:\/\/com.fuad.batagor\/tutorials\/BatagorTutorials\/$volume","doc:\/\/com.fuad.batagor\/tutorials\/BatagorTu