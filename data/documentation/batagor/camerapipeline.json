{"identifier":{"url":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/CameraPipeline","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"batagor"}],"role":"article","title":"Camera Pipeline","roleHeading":"Article"},"abstract":[{"type":"text","text":"How a frame goes from the camera sensor to a saved, expiring file."}],"sections":[],"seeAlsoSections":[{"title":"Subsystems","anchor":"Subsystems","generated":true,"identifiers":["doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion","doc:\/\/com.fuad.batagor\/documentation\/batagor\/WidgetIntegration","doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"CameraManager"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Core\/Services\/Camera\/"},{"type":"text","text":") is a thin wrapper around "},{"type":"codeVoice","code":"AVFoundation"},{"type":"text","text":". It"},{"type":"text","text":" "},{"type":"text","text":"owns the "},{"type":"codeVoice","code":"AVCaptureSession"},{"type":"text","text":" and exposes three "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":"s instead of delegate"},{"type":"text","text":" "},{"type":"text","text":"callbacks, so "},{"type":"codeVoice","code":"CameraViewModel"},{"type":"text","text":" can consume them with "},{"type":"codeVoice","code":"for await"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"previewStream: AsyncStream<CIImage>","type":"codeVoice"},{"type":"text","text":" — live viewfinder frames, produced in"},{"type":"text","text":" "},{"code":"AVCaptureVideoDataOutputSampleBufferDelegate.captureOutput(_:didOutput:from:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"photoStream: AsyncStream<Data>","type":"codeVoice"},{"type":"text","text":" — encoded photo data per "},{"code":"takePhoto()","type":"codeVoice"},{"type":"text","text":" call,"},{"type":"text","text":" "},{"type":"text","text":"extracted immediately in"},{"type":"text","text":" "},{"code":"AVCapturePhotoCaptureDelegate.photoOutput(_:didFinishProcessingPhoto:error:)","type":"codeVoice"},{"type":"text","text":" so the"},{"type":"text","text":" "},{"code":"AVCapturePhoto","type":"codeVoice"},{"type":"text","text":" instance (and its underlying hardware "},{"code":"IOSurface","type":"codeVoice"},{"type":"text","text":" buffer) is released"},{"type":"text","text":" "},{"type":"text","text":"as soon as the delegate callback returns."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"movieFileStream: AsyncStream<URL>","type":"codeVoice"},{"type":"text","text":" — the finished movie file URL after"},{"type":"text","text":" "},{"code":"stopRecordingVideo()","type":"codeVoice"},{"type":"text","text":", produced in"},{"type":"text","text":" "},{"code":"AVCaptureFileOutputRecordingDelegate.fileOutput(_:didFinishRecordingTo:from:error:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"CameraViewModel.init()"},{"type":"text","text":" starts three "},{"type":"codeVoice","code":"Task"},{"type":"text","text":"s ("},{"type":"codeVoice","code":"handleCameraPreview"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"handleCameraPhoto"},{"type":"text","text":", "},{"type":"codeVoice","code":"handleCameraMovie"},{"type":"text","text":") that each drain one of these streams."},{"type":"text","text":" "},{"type":"codeVoice","code":"handleCameraPreview"},{"type":"text","text":" publishes frames to "},{"type":"codeVoice","code":"previewImage"},{"type":"text","text":" (which also gates the shutter"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"CameraToolbar"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CameraViewModel"},{"type":"text","text":" so captures cannot fire while the preview is"},{"type":"text","text":" "},{"type":"text","text":"still blank), while "},{"type":"codeVoice","code":"handleCameraPhoto"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleCameraMovie"},{"type":"text","text":" trigger persistence"},{"type":"text","text":" "},{"type":"text","text":"directly from the view model rather than through view "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":" modifiers."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Capture flow","anchor":"Capture-flow"},{"syntax":null,"type":"codeListing","code":["CameraManager.start()","  └─ checkCameraAuthorization() → configureCaptureSession() → captureSession.startRunning()","","User taps shutter (photo)","  CameraViewModel.capturePhoto(storedCount:)","    → guards previewImage != nil and storedCount + pendingSaves < Storage.mediaLimit","    → increments pendingSaves + starts UIApplication background task","    → camera.takePhoto()","        → snapshots latestPreviewImage in fallbackImagesByID[photoSettings.uniqueID]","        → AVCapturePhotoOutput.capturePhoto(...)","        → photoOutput(_:didFinishProcessingPhoto:error:)","            ├─ photo.fileDataRepresentation() succeeds → photoStream yields HEIC Data","            └─ nil (e.g. session interrupted on backgrounding) → encodes fallback","               viewfinder snapshot to JPEG Data → photoStream yields Data","    → handleCameraPhoto() appends (Data, currentLocation) to photoQueue","    → handleSavePhoto(context:) drains photoQueue:","        → Task.detached: addLocationToImageData + savePhoto(data:) + saveThumbnail(data:)","        → @MainActor: inserts Storage row + saves ModelContext + reloads widget timelines","        → decrements pendingSaves","        → enqueueGeocode(for:context:) resolves place name sequentially in background","        → enqueueFocusDetection(for:context:) finds the thumbnail focus sequentially in background","","User holds shutter (video)","  CameraViewModel.startRecordingVideo(storedCount:)","    → guards previewImage != nil, !isCameraInterrupted, and capacity under mediaLimit","    → increments pendingSaves + starts UIApplication background task","    → camera.startRecordingVideo() \/ stopRecordingVideo()","        → movieFileOutput writes directly to the App Group container","        → fileOutput(_:didFinishRecordingTo:from:error:) → movieFileStream yields URL","    → handleSaveMovie(context:) embeds location + generates thumbnail + saves Storage row,","      then queues reverse-geocoding via enqueueGeocode(for:context:) and focus detection","      via enqueueFocusDetection(for:context:)"]},{"type":"heading","level":2,"text":"Fast capture and backgrounding resilience","anchor":"Fast-capture-and-backgrounding-resilience"},{"inlineContent":[{"type":"text","text":"Rapid shutter taps followed immediately by navigating away or swiping to the iOS Home"},{"type":"text","text":" "},{"type":"text","text":"Screen exercise several edge cases that the pipeline handles explicitly:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Adaptive burst prioritization","type":"text"}]},{"type":"text","text":": "},{"code":"configureCaptureSession(completionHandler:)","type":"codeVoice"},{"type":"text","text":" sets"},{"type":"text","text":" "},{"code":"photoOutput.maxPhotoQualityPrioritization = .balanced","type":"codeVoice"},{"type":"text","text":" and enables both"},{"type":"text","text":" "},{"code":"isResponsiveCaptureEnabled","type":"codeVoice"},{"type":"text","text":" and "},{"code":"isFastCapturePrioritizationEnabled","type":"codeVoice"},{"type":"text","text":", while"},{"type":"text","text":" "},{"code":"takePhoto()","type":"codeVoice"},{"type":"text","text":" requests "},{"code":"photoSettings.photoQualityPrioritization = .balanced","type":"codeVoice"},{"type":"text","text":". Normal"},{"type":"text","text":" "},{"type":"text","text":"single shots get full multi-frame fusion quality, while rapid back-to-back taps are"},{"type":"text","text":" "},{"type":"text","text":"automatically accelerated by "},{"code":"AVCapturePhotoOutput","type":"codeVoice"},{"type":"text","text":" without stalling the pipeline."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Immediate ","type":"text"},{"code":"IOSurface","type":"codeVoice"},{"text":" release","type":"text"}]},{"type":"text","text":": "},{"code":"AVCapturePhotoOutput","type":"codeVoice"},{"type":"text","text":" has a small, fixed-size pool"},{"type":"text","text":" "},{"type":"text","text":"of hardware pixel buffers. Extracting "},{"code":"photo.fileDataRepresentation()","type":"codeVoice"},{"type":"text","text":" inside"},{"type":"text","text":" "},{"code":"photoOutput(_:didFinishProcessingPhoto:error:)","type":"codeVoice"},{"type":"text","text":" and yielding "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" (instead of"},{"type":"text","text":" "},{"type":"text","text":"retaining "},{"code":"AVCapturePhoto","type":"codeVoice"},{"type":"text","text":" across async queues) returns each buffer to the pool in"},{"type":"text","text":" "},{"type":"text","text":"under a millisecond so burst captures never starve the sensor."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Viewfinder snapshot fallback","type":"text"}]},{"type":"text","text":": iOS immediately interrupts "},{"code":"AVCaptureSession","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"code":".videoDeviceNotAvailableInBackground","type":"codeVoice"},{"type":"text","text":" when the app enters the background, which"},{"type":"text","text":" "},{"type":"text","text":"aborts any queued "},{"code":"AVCapturePhotoOutput","type":"codeVoice"},{"type":"text","text":" requests that have not finished sensor"},{"type":"text","text":" "},{"type":"text","text":"capture yet ("},{"code":"photo.fileDataRepresentation()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"). To avoid dropping those"},{"type":"text","text":" "},{"type":"text","text":"trailing shots, "},{"code":"takePhoto()","type":"codeVoice"},{"type":"text","text":" records the latest viewfinder "},{"code":"CIImage","type":"codeVoice"},{"type":"text","text":" and rotation"},{"type":"text","text":" "},{"type":"text","text":"angle in "},{"code":"fallbackImagesByID","type":"codeVoice"},{"type":"text","text":" keyed by "},{"code":"photoSettings.uniqueID","type":"codeVoice"},{"type":"text","text":"; if hardware capture"},{"type":"text","text":" "},{"type":"text","text":"is interrupted, "},{"code":"encodeFallbackSnapshot(_:)","type":"codeVoice"},{"type":"text","text":" encodes that captured frame to JPEG "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and yields it to "},{"code":"photoStream","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Deferred session stop","type":"text"}]},{"type":"text","text":": "},{"code":"CameraManager.stop()","type":"codeVoice"},{"type":"text","text":" tracks "},{"code":"inFlightPhotoCount","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"sessionQueue","type":"codeVoice"},{"type":"text","text":". If the user leaves "},{"code":"CameraView","type":"codeVoice"},{"type":"text","text":" while captures are still in flight,"},{"type":"text","text":" "},{"code":"shouldStopWhenPhotosFinish","type":"codeVoice"},{"type":"text","text":" defers "},{"code":"captureSession.stopRunning()","type":"codeVoice"},{"type":"text","text":" until the last"},{"type":"text","text":" "},{"type":"text","text":"in-flight photo callback completes."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Off-main-actor I\/O and immediate SwiftData insert","type":"text"}]},{"type":"text","text":": "},{"code":"handleSavePhoto(context:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"runs EXIF GPS merging ("},{"code":"LocationManager.addLocationToImageData(_:location:)","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"full-resolution file writing ("},{"code":"StorageManager.savePhoto(data:)","type":"codeVoice"},{"type":"text","text":"), and ImageIO"},{"type":"text","text":" "},{"type":"text","text":"thumbnail downsampling ("},{"code":"StorageManager.saveThumbnail(data:)","type":"codeVoice"},{"type":"text","text":") inside a detached task"},{"type":"text","text":" "},{"type":"text","text":"off "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":". The "},{"code":"Storage","type":"codeVoice"},{"type":"text","text":" record is inserted and saved into "},{"code":"ModelContext","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"immediately—before network reverse-geocoding ("},{"code":"enqueueGeocode(for:context:)","type":"codeVoice"},{"type":"text","text":")—while a"},{"type":"text","text":" "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" background task keeps the process alive until "},{"code":"pendingSaves","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"activeGeocodeCount","type":"codeVoice"},{"type":"text","text":" and "},{"code":"activeFocusCount","type":"codeVoice"},{"type":"text","text":" all reach zero."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Focus detection after the save","type":"text"}]},{"type":"text","text":": "},{"code":"enqueueFocusDetection(for:context:)","type":"codeVoice"},{"type":"text","text":" runs"},{"type":"text","text":" "},{"code":"ThumbnailFocusService","type":"codeVoice"},{"type":"text","text":" (Vision) after the row is saved, one snap at a time and off"},{"type":"text","text":" "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":", on its own chain, so it never delays the insert or the burst queue. Photos"},{"type":"text","text":" "},{"type":"text","text":"are read from "},{"code":"mainPath","type":"codeVoice"},{"type":"text","text":" at up to 2048px through"},{"type":"text","text":" "},{"code":"StorageManager.loadDownsampledImage(fileURL:maxPixelSize:)","type":"codeVoice"},{"type":"text","text":" rather than from the"},{"type":"text","text":" "},{"type":"text","text":"low-quality thumbnail JPEG; videos use their saved thumbnail frame. Any failure leaves"},{"type":"text","text":" "},{"type":"text","text":"the focus nil and the snap saved. The row is fetched again by "},{"code":"id","type":"codeVoice"},{"type":"text","text":" before writing, in"},{"type":"text","text":" "},{"type":"text","text":"case it was deleted while Vision ran. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Background interruption filtering","type":"text"}]},{"type":"text","text":": "},{"code":"observeInterruptions()","type":"codeVoice"},{"type":"text","text":" ignores"},{"type":"text","text":" "},{"code":".videoDeviceNotAvailableInBackground","type":"codeVoice"},{"type":"text","text":" when setting "},{"code":"interruptionMessage","type":"codeVoice"},{"type":"text","text":" so normal"},{"type":"text","text":" "},{"type":"text","text":"app backgrounding never surfaces a "},{"code":"\"Camera unavailable\"","type":"codeVoice"},{"type":"text","text":" alert, and "},{"code":"CameraViewModel","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"binds "},{"code":"showInterruptionAlert","type":"codeVoice"},{"type":"text","text":" to "},{"code":"message != nil","type":"codeVoice"},{"type":"text","text":" so any alert clears when the"},{"type":"text","text":" "},{"type":"text","text":"interruption ends."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"Earlier pipeline and why it changed","anchor":"Earlier-pipeline-and-why-it-changed"},{"inlineContent":[{"type":"text","text":"Before BAT-108, BAT-109, and BAT-111, the capture flow worked as follows:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["User taps shutter (earlier flow)","  CameraToolbar (enabled before previewImage arrived; disabled at capacity without alert)","    → camera.takePhoto()","    → photoOutput(_:didFinishProcessingPhoto:) → photoStream yields AVCapturePhoto","    → CameraViewModel.unpackPhoto(_:) decodes fileDataRepresentation() + cgImageRepresentation()","      on @MainActor and publishes photoTaken","    → CameraView .onChange(of: photoTaken?.imageData) spawns Task { handleSavePhoto(context:) }","    → handleSavePhoto(context:) on @MainActor:","        writes photo + UIImage thumbnail → awaits storeLocation(storage:) (CLGeocoder)","        → inserts Storage row into SwiftData (counter updates only after save finishes)"]},{"inlineContent":[{"type":"text","text":"That earlier design had several failure modes under fast capture or quick navigation:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Counter lag and silent capacity taps (BAT-108)","type":"text"}]},{"type":"text","text":": The gallery counter only read"},{"type":"text","text":" "},{"type":"text","text":"persisted "},{"code":"@Query","type":"codeVoice"},{"type":"text","text":" rows, so rapid taps did not increment the counter until disk I\/O"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"CLGeocoder","type":"codeVoice"},{"type":"text","text":" finished, and disabling the shutter at 24\/24 prevented tapping the"},{"type":"text","text":" "},{"type":"text","text":"shutter from surfacing the storage-limit alert."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Captures before preview readiness (BAT-111)","type":"text"}]},{"type":"text","text":": "},{"code":"CameraToolbar","type":"codeVoice"},{"type":"text","text":" did not check"},{"type":"text","text":" "},{"code":"previewImage == nil","type":"codeVoice"},{"type":"text","text":", allowing shutter taps while the viewfinder was still blank"},{"type":"text","text":" "},{"type":"text","text":"before "},{"code":"AVCaptureSession","type":"codeVoice"},{"type":"text","text":" produced its first frame."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Buffer starvation and dropped shots on backgrounding\/navigation (BAT-109)","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Passing live ","type":"text"},{"type":"codeVoice","code":"AVCapturePhoto"},{"text":" objects through ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":" while ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" ","type":"text"},{"text":"performed synchronous bitmap decoding (","type":"text"},{"type":"codeVoice","code":"cgImageRepresentation()"},{"text":"), EXIF re-encoding,","type":"text"},{"text":" ","type":"text"},{"text":"and full-resolution ","type":"text"},{"type":"codeVoice","code":"UIGraphicsImageRenderer"},{"text":" thumbnail drawing exhausted","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AVCapturePhotoOutput"},{"text":"’s small hardware ","type":"text"},{"type":"codeVoice","code":"IOSurface"},{"text":" pool after ~4–6 shots.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Triggering ","type":"text"},{"type":"codeVoice","code":"handleSavePhoto"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"handleSaveMovie"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"CameraView"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":".onChange"},{"text":" ","type":"text"},{"text":"modifiers meant saves stopped firing as soon as ","type":"text"},{"type":"codeVoice","code":"CameraView"},{"text":" unmounted or entered","type":"text"},{"text":" ","type":"text"},{"text":"the background.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Awaiting ","type":"text"},{"type":"codeVoice","code":"storeLocation(storage:)"},{"text":" (","type":"text"},{"type":"codeVoice","code":"CLGeocoder"},{"text":") ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"context.insert(storage)"},{"text":" ","type":"text"},{"text":"without a ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" background task caused in-flight saves to suspend before","type":"text"},{"text":" ","type":"text"},{"text":"reaching SwiftData when swiping to the Home Screen.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"Rotation and device switching","anchor":"Rotation-and-device-switching"},{"inlineContent":[{"type":"codeVoice","code":"CameraManager"},{"type":"text","text":" tracks device orientation itself via "},{"type":"codeVoice","code":"AVCaptureDevice.RotationCoordinator"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"setupRotationCoordinator()"},{"type":"text","text":"), independent of "},{"type":"codeVoice","code":"OrientationManager"},{"type":"text","text":" (which drives UI"},{"type":"text","text":" "},{"type":"text","text":"rotation via "},{"type":"codeVoice","code":"CoreMotion"},{"type":"text","text":"). "},{"type":"codeVoice","code":"switchCaptureDevices()"},{"type":"text","text":" cycles between the first"},{"type":"text","text":" "},{"type":"text","text":"available back and front camera; "},{"type":"codeVoice","code":"updateSessionForCaptureDevice(_:)"},{"type":"text","text":" reconfigures the"},{"type":"text","text":" "},{"type":"text","text":"session’s input without tearing down outputs."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Location tagging","anchor":"Location-tagging"},{"inlineContent":[{"type":"text","text":"Both photos and videos get their coordinate stored on the "},{"type":"codeVoice","code":"Storage"},{"type":"text","text":" record"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"latitude"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"longitude"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"altitude"},{"type":"text","text":") and embedded in the file. For photos,"},{"type":"text","text":" "},{"type":"codeVoice","code":"handleSavePhoto(context:)"},{"type":"text","text":" writes the original "},{"type":"codeVoice","code":"AVCapturePhoto"},{"type":"text","text":" data (so EXIF, lens and"},{"type":"text","text":" "},{"type":"text","text":"timestamp metadata survive) after "},{"type":"codeVoice","code":"LocationManager.addLocationToImageData(_:location:)"},{"type":"text","text":" "},{"type":"text","text":"merges in the GPS dictionary. For videos, "},{"type":"codeVoice","code":"handleSaveMovie(context:)"},{"type":"text","text":" awaits"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocationManager.addLocationToVideo(at:location:)"},{"type":"text","text":", which embeds QuickTime location"},{"type":"text","text":" "},{"type":"text","text":"metadata into the exported movie file. When saving to the Photos app,"},{"type":"text","text":" "},{"type":"codeVoice","code":"PhotoLibraryService"},{"type":"text","text":" also sets the asset’s creation date and location."},{"type":"text","text":" "},{"type":"text","text":"Both photo and"},{"type":"text","text":" "},{"type":"text","text":"video saves also reverse-geocode the coordinate into a human-readable place name —"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/batagor\/camerapipeline"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.fuad.batagor\/documentation\/batagor"]]},"references":{"doc://com.fuad.batagor/documentation/batagor":{"role":"collection","kind":"symbol","url":"\/documentation\/batagor","title":"batagor","abstract":[{"text":"Temporary storage for photos and videos — captures expire and clean themselves up","type":"text"},{"type":"text","text":" "},{"type":"text","text":"automatically so they never clutter your camera roll."}],"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor","type":"topic"},"doc://com.fuad.batagor/documentation/batagor/LocationAndGeocoding":{"type":"topic","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/LocationAndGeocoding","url":"\/documentation\/batagor\/locationandgeocoding","title":"Location and Geocoding","abstract":[{"text":"How captured media gets tagged with where it was taken.","type":"text"}],"role":"article","kind":"article"},"doc://com.fuad.batagor/documentation/batagor/WidgetIntegration":{"role":"article","kind":"article","url":"\/documentation\/batagor\/widgetintegration","abstract":[{"text":"How the Home Screen widget stays in sync with the app without any explicit","type":"text"},{"text":" ","type":"text"},{"text":"messaging between the two targets.","type":"text"}],"title":"Widget Integration","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/WidgetIntegration","type":"topic"},"doc://com.fuad.batagor/documentation/batagor/StorageAndDeletion":{"type":"topic","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/StorageAndDeletion","url":"\/documentation\/batagor\/storageanddeletion","title":"Storage and Deletion","abstract":[{"text":"Where files and records live, and how expired media gets removed.","type":"text"}],"role":"article","kind":"article"}}}