ype":"text"},{"text":" ","type":"text"},{"text":"every ","type":"text"},{"code":"Storage","type":"codeVoice"},{"text":" row, filters where ","type":"text"},{"code":"expiredAt < Date()","type":"codeVoice"},{"text":", deletes the backing files","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"StorageManager.deleteFile(fileURL:)","type":"codeVoice"},{"text":", deletes the SwiftData rows, and calls","type":"text"},{"text":" ","type":"text"},{"code":"WidgetCenter.shared.reloadAllTimelines()","type":"codeVoice"},{"text":" so the widget picks up the change.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"ThumbnailFocusService","type":"codeVoice"}],"type":"strong"},{"text":" (","type":"text"},{"code":"static let shared","type":"codeVoice"},{"text":") finds the point a cropped thumbnail","type":"text"},{"text":" ","type":"text"},{"text":"should pan to, using on-device Vision. See “Thumbnail focus” below.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"Storage","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Models\/Storage.swift","type":"codeVoice"},{"text":") is the SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":": it stores file URLs","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"mainPath","type":"codeVoice"},{"text":", ","type":"text"},{"code":"thumbnailPath","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"createdAt","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"expiredAt","type":"codeVoice"},{"text":", optional GPS fields, an","type":"text"},{"text":" ","type":"text"},{"text":"optional thumbnail focus (","type":"text"},{"code":"focusX","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"focusY","type":"codeVoice"},{"text":"), and computed helpers (","type":"text"},{"code":"isExpired","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"isVideo","type":"codeVoice"},{"text":", ","type":"text"},{"code":"timeRemaining","type":"codeVoice"},{"text":", ","type":"text"},{"code":"focusPoint","type":"codeVoice"},{"text":"). Expiry defaults to 24 hours from ","type":"text"},{"code":"createdAt","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unless a custom ","type":"text"},{"code":"expiredAt","type":"codeVoice"},{"text":" interval is passed in.","type":"text"}],"type":"paragraph"},{"anchor":"Thumbnail-focus","text":"Thumbnail focus","type":"heading","level":2},{"inlineContent":[{"text":"Every screen crops the same thumbnail, and on a roughly 393pt-wide phone the 170pt","type":"text"},{"text":" ","type":"text"},{"text":"gallery card shows only about the middle 24% of a portrait photo’s height. So the snap","type":"text"},{"text":" ","type":"text"},{"text":"stores where to look rather than a second, cropped file; the thumbnail JPEG itself is","type":"text"},{"text":" ","type":"text"},{"text":"never changed.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"ThumbnailFocusService","type":"codeVoice"}],"type":"strong"},{"text":" finds the point: the centre of the largest confident text","type":"text"},{"text":" ","type":"text"},{"text":"box containing a digit, or, if there’s none or it covers most of the frame, the centre","type":"text"},{"text":" ","type":"text"},{"text":"of the main object from a saliency request. Otherwise there is no focus. Its thresholds","type":"text"},{"text":" ","type":"text"},{"text":"are named constants, still provisional until tuned on the sample photo set.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"Storage.focusX","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"focusY","type":"codeVoice"}],"type":"strong"},{"text":" hold the point, normalized 0 to 1 with a top-left origin.","type":"text"},{"text":" ","type":"text"},{"text":"Both are optional and additive, so rows that predate them stay nil.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"FocusFillImage","type":"codeVoice"}],"type":"strong"},{"text":" pans an aspect-fill image to the point at each call site, clamped","type":"text"},{"text":" ","type":"text"},{"text":"so no gap ever shows and never zooming. With a nil focus it’s a plain aspect-fill, so","type":"text"},{"text":" ","type":"text"},{"text":"that screen renders exactly as it would without a focus.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A number at the very edge of a photo can only pan as far as that edge, so on the gallery","type":"text"},{"text":" ","type":"text"},{"text":"card it can still sit under ","type":"text"},{"code":"TimeRemainingBar","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/CameraPipeline","isActive":true,"type":"reference"},{"text":" for when detection runs.","type":"text"}],"type":"paragraph"},{"anchor":"The-media-limit","text":"The media limit","type":"heading","level":2},{"inlineContent":[{"code":"Storage.mediaLimit","type":"codeVoice"},{"text":" (24) is the single source of truth, enforced in two layers:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"CameraViewModel.capturePhoto(storedCount:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"startRecordingVideo(storedCount:)","type":"codeVoice"}],"type":"strong"},{"text":" ","type":"text"},{"text":"gate the shutter: each allows capture only while the stored count plus in-flight","type":"text"},{"text":" ","type":"text"},{"text":"media items (","type":"text"},{"code":"pendingSaves","type":"codeVoice"},{"text":") is under the limit, so fast burst taps and video","type":"text"},{"text":" ","type":"text"},{"text":"recordings cannot outrun the ","type":"text"},{"code":"@Query","type":"codeVoice"},{"text":" count.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"StorageManager.hasCapacity(in:)","type":"codeVoice"}],"type":"strong"},{"text":" is the final guard, run with a live","type":"text"},{"text":" ","type":"text"},{"code":"fetchCount","type":"codeVoice"},{"text":" before writing files and again right before ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":". If the limit was","type":"text"},{"text":" ","type":"text"},{"text":"reached in the meantime, the saved files are discarded.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"When-deletion-actually-runs","text":"When deletion actually runs","type":"heading","level":2},{"inlineContent":[{"code":"DeletionService","type":"codeVoice"},{"text":" doesn’t run on a fixed timer — it’s invoked from three places:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"On launch\/foreground","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"batagorApp","type":"codeVoice"},{"text":"’s root view runs ","type":"text"},{"code":"performCleanup(modelContext:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":", so expired items are swept the moment the app becomes active —","type":"text"},{"text":" ","type":"text"},{"text":"the most common path in practice, since most sessions start with the app opening.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Background","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":".backgroundTask(.appRefresh(DeletionService.backgroundTaskIdentifier))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"batagorApp","type":"codeVoice"},{"text":" is what actually registers the handler with the system; inside it,","type":"text"},{"text":" ","type":"text"},{"code":"performCleanup(modelContext:)","type":"codeVoice"},{"text":" runs and then re-arms itself via","type":"text"},{"text":" ","type":"text"},{"code":"scheduleBackgroundCleanup()","type":"codeVoice"},{"text":", which submits a ","type":"text"},{"code":"BGAppRefreshTaskRequest","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"BackgroundTasks","type":"codeVoice"},{"text":" framework) for the system to run opportunistically later. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.fuad.batagor\/documentation\/batagor\/AppLifecycle"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Manual","type":"text"}],"type":"strong"},{"text":": every user-initiated delete goes through a ","type":"text"},{"code":"manualDelete","type":"codeVoice"},{"text":" overload —","type":"text"},{"text":" ","type":"text"},{"code":"manualDelete(modelContext:storage:)","type":"codeVoice"},{"text":" from the gallery card’s long-press menu and","type":"text"},{"text":" ","type":"text"},{"text":"the detail view, and ","type":"text"},{"code":"manualDelete(modelContext:ids:)","type":"codeVoice"},{"text":" from swipe-to-delete and","type":"text"},{"text":" ","type":"text"},{"text":"select-mode bulk delete. The ID variant fetches the rows at call time, so a row","type":"text"},{"text":" ","type":"text"},{"text":"expiry cleanup already removed is skipped. A bulk delete saves once and reloads","type":"text"},{"text":" ","type":"text"},{"text":"widget timelines once.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"All three paths funnel through the same file-then-record deletion order and the same","type":"text"},{"text":" ","type":"text"},{"code":"WidgetCenter","type":"codeVoice"},{"text":" reload, so there’s a single source of truth for “how a ","type":"text"},{"code":"Storage","type":"codeVoice"},{"text":" row","type":"text"},{"text":" ","type":"text"},{"text":"disappears.” No view deletes a ","type":"text"},{"code":"Storage","type":"codeVoice"},{"text":" row with ","type":"text"},{"code":"modelContext.delete","type":"codeVoice"},{"text":" directly:","type":"text"},{"text":" ","type":"text"},{"text":"that leaves the row’s files on disk with nothing pointing at them.","type":"text"}],"type":"paragraph"},{"anchor":"Orphaned-files","text":"Orphaned files","type":"heading","level":2},{"inlineContent":[{"text":"A file in ","type":"text"},{"code":"Photos\/","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Movies\/","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Thumbnails\/","type":"codeVoice"},{"text":" that no ","type":"text"},{"code":"Storage","type":"codeVoice"},{"text":" row references is","type":"text"},{"text":" ","type":"text"},{"text":"unreachable by the paths above, since they all work from rows. Such files come from","type":"text"},{"text":" ","type":"text"},{"text":"swipe deletes before BAT-84 and bulk deletes before BAT-86 (both deleted only the","type":"text"},{"text":" ","type":"text"},{"text":"row), a capture whose save failed partway, a movie that finished recording after its","type":"text"},{"text":" ","type":"text"},{"code":"CameraView","type":"codeVoice"},{"text":" was gone, or a video location export interrupted mid-write.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"removeOrphanedFiles(modelContext:)","type":"codeVoice"},{"text":" sweeps them on launch, right after the expiry","type":"text"},{"text":" ","type":"text"},{"text":"cleanup in ","type":"text"},{"code":"batagorApp","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Files are matched to rows by ","type":"text"},{"type":"strong","inlineContent":[{"text":"file name","type":"text"}]},{"t